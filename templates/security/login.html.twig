{% extends 'base.html.twig' %}

{% block title %}Вход — Redbox{% endblock %}

{% block body %}
    <section class="min-h-screen bg-neutral-primary grid lg:grid-cols-2">

        {# Decorative panel (desktop only): background only #}
        <div class="relative hidden overflow-hidden bg-zinc-950 text-white lg:block" aria-hidden="true">
            {# subtle grid pattern #}
            <svg class="absolute inset-0 h-full w-full opacity-10" aria-hidden="true">
                <defs>
                    <pattern id="login-grid" width="40" height="40" patternUnits="userSpaceOnUse">
                        <path d="M40 0H0V40" fill="none" stroke="currentColor" stroke-width="1"/>
                    </pattern>
                </defs>
                <rect width="100%" height="100%" fill="url(#login-grid)"/>
            </svg>
            <div class="absolute -right-24 -top-24 h-96 w-96 rounded-full bg-accent/40 blur-3xl" aria-hidden="true"></div>
            <div class="absolute -bottom-32 -left-16 h-96 w-96 rounded-full bg-accent/15 blur-3xl" aria-hidden="true"></div>
        </div>

        {# Form panel #}
        <div class="flex min-h-full flex-col justify-center px-6 py-12 sm:px-12 lg:px-20 xl:px-28">
            <div class="mx-auto w-full max-w-md">
                <div class="mb-10 flex items-center gap-3">
                    <img src="{{ asset('images/brand/logo-250.png') }}" alt="" width="44" height="44" class="size-11 rounded-xl shadow-lg shadow-accent/30">
                    <span class="text-2xl font-bold tracking-tight text-heading">Redbox</span>
                </div>

                <h1 class="text-3xl font-bold tracking-tight text-heading mb-2">Добро пожаловать</h1>
                <p class="text-body mb-8">Войдите, чтобы управлять конструкциями</p>

                {% if error %}
                    <div class="flex items-start gap-3 p-4 mb-6 text-sm rounded-base border text-fg-danger-strong bg-danger-soft border-danger-subtle" role="alert">
                        <svg class="h-5 w-5 shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/></svg>
                        <span>{{ error.messageKey|trans(error.messageData, 'security') }}</span>
                    </div>
                {% endif %}

                <form method="post" action="{{ path('app_login') }}" class="space-y-6">
                    <div>
                        <label for="username" class="block mb-2.5 text-sm font-medium text-heading">Email</label>
                        <div class="relative">
                            <div class="pointer-events-none absolute inset-y-0 start-0 flex items-center ps-3.5 text-body">
                                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"/></svg>
                            </div>
                            <input type="email" id="username" name="_username" value="{{ last_username }}"
                                   class="input h-11 !ps-11 text-base" placeholder="you@example.com"
                                   autocomplete="email" required autofocus>
                        </div>
                    </div>

                    <div>
                        <label for="password" class="block mb-2.5 text-sm font-medium text-heading">Пароль</label>
                        <div class="relative">
                            <div class="pointer-events-none absolute inset-y-0 start-0 flex items-center ps-3.5 text-body">
                                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z"/></svg>
                            </div>
                            <input type="password" id="password" name="_password"
                                   class="input h-11 !ps-11 !pe-12 text-base" placeholder="••••••••"
                                   autocomplete="current-password" required>
                            <button type="button" data-password-toggle="password" aria-label="Показать пароль" aria-pressed="false"
                                    class="absolute inset-y-0 end-0 flex items-center pe-3.5 text-body hover:text-heading cursor-pointer">
                                <svg data-icon="show" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                                <svg data-icon="hide" class="hidden h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 001.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.45 10.45 0 0112 4.5c4.756 0 8.773 3.162 10.065 7.498a10.523 10.523 0 01-4.293 5.774M6.228 6.228L3 3m3.228 3.228l3.65 3.65m7.894 7.894L21 21m-3.228-3.228l-3.65-3.65m0 0a3 3 0 10-4.243-4.243m4.242 4.242L9.88 9.88"/></svg>
                            </button>
                        </div>
                    </div>

                    <div class="flex items-center">
                        <input type="checkbox" id="remember_me" name="_remember_me"
                               class="w-4 h-4 border border-default-medium rounded-xs bg-neutral-secondary-medium focus:ring-2 focus:ring-brand-soft">
                        <label for="remember_me" class="ms-2 text-sm font-medium text-heading select-none">Запомнить меня на 2 недели</label>
                    </div>

                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                    <button type="submit" class="btn btn-primary h-11 w-full text-base">
                        Войти
                        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/></svg>
                    </button>
                </form>

                <p class="mt-10 text-sm text-body">Нет доступа? Обратитесь к администратору.</p>
            </div>
        </div>
    </section>
{% endblock %}
