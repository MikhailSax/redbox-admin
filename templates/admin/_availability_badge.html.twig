{# Free / booked / occupied badge. Vars: status (AvailabilityStatus|null), label? (override text), size? ('sm' | 'lg') #}
{% set tones = {free: 'success', booked: 'warning', occupied: 'danger'} %}
{% if status %}
    <span class="lozenge lozenge-{{ tones[status.value] }} {{ (size|default('sm')) == 'lg' ? '!h-6 !px-2 !text-xs' : '' }}">{{ label|default(status.label) }}</span>
{% else %}
    <span class="text-xs text-body">—</span>
{% endif %}
