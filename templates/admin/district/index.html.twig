{% extends 'admin/layout.html.twig' %}

{% block title %}Районы — {{ parent() }}{% endblock %}

{% block content %}
    <div class="page-header">
        <h1 class="page-title">Районы</h1>
        <a href="{{ path('admin_district_new') }}" class="btn btn-primary">+ Добавить район</a>
    </div>

    <div class="table-card">
        <table class="data-table">
            <thead>
                <tr>
                    <th scope="col" class="px-4 py-3 font-medium">Название</th>
                    <th scope="col" class="px-4 py-3 font-medium">Описание</th>
                    <th scope="col" class="px-4 py-3 font-medium text-right">Конструкций</th>
                    <th scope="col" class="px-4 py-3 font-medium"><span class="sr-only">Действия</span></th>
                </tr>
            </thead>
            <tbody>
                {% for district in districts %}
                    {% set used = productCounts[district.id] ?? 0 %}
                    <tr>
                        <th scope="row" class="px-4 py-3 font-medium text-heading">
                            <a href="{{ path('admin_district_edit', {id: district.id}) }}" class="hover:underline">{{ district.name }}</a>
                        </th>
                        <td class="px-4 py-3">{{ district.shortDescription ?? '—' }}</td>
                        <td class="px-4 py-3 text-right">{{ used }}</td>
                        <td class="px-4 py-3">
                            <div class="flex justify-end gap-2">
                                <a href="{{ path('admin_district_edit', {id: district.id}) }}" class="btn btn-secondary btn-sm">Изменить</a>
                                {{ include('admin/_delete_form.html.twig', {
                                    action: path('admin_district_delete', {id: district.id}),
                                    token_id: 'delete-district-' ~ district.id,
                                    confirm: 'Удалить район «' ~ district.name ~ '»?' ~ (used ? ' У конструкций (' ~ used ~ ') район станет не указан.' : ''),
                                }) }}
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="4" class="px-4 py-10 text-center">
                            Районов пока нет. <a href="{{ path('admin_district_new') }}" class="font-medium text-fg-brand hover:underline">Добавить первый</a>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
