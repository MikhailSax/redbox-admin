{% extends 'admin/layout.html.twig' %}
{% import 'admin/_icons.html.twig' as ui %}

{#
    Payment calendar. Vars: month, weeks (PaymentCalendar::weeks), list (payments of the month, by status),
    overdue (of every month), totals, status, type, q, now.
#}
{% block title %}Платежи — {{ parent() }}{% endblock %}

{% block content %}
    {% set filters = {type: type ? type.value : null, q: q ?: null}|filter(v => v is not null) %}
    {% set month_key = month|date('Y-m') %}
    {% set tones = {
        upcoming: 'border-default bg-white text-heading hover:bg-zinc-50',
        soon: 'border-warning-subtle bg-warning-soft text-fg-warning hover:brightness-95',
        overdue: 'border-danger-subtle bg-danger-soft text-fg-danger-strong hover:brightness-95',
        paid: 'border-success-subtle bg-success-soft text-fg-success-strong hover:brightness-95',
    } %}

    <div class="page-header">
        <div>
            <h1 class="page-title">Платежи</h1>
            <p class="page-subtitle">Календарь оплат: какой клиент, сколько и до какого числа должен заплатить</p>
        </div>
        <a href="{{ path('admin_payment_new') }}" class="btn btn-primary">{{ ui.icon('plus', 'size-4') }} Новый платёж</a>
    </div>

    {# Totals #}
    {% set kpis = [
        {label: 'Просрочено', value: totals.overdue, hint: 'всего, по всем месяцам', dot: 'bg-danger', href: '#overdue'},
        {label: 'Скоро срок', value: totals.soon, hint: 'в ближайшие ' ~ constant('App\\Enum\\PaymentStatus::SOON_DAYS') ~ ' дня', dot: 'bg-warning', href: path('admin_payment_index', filters|merge({status: 'soon'})) ~ '#list'},
        {label: 'Ожидается', value: totals.monthExpected, hint: 'к оплате в ' ~ month|month_label|lower, dot: 'bg-zinc-300', href: path('admin_payment_index', filters|merge({month: month_key, status: 'upcoming'})) ~ '#list'},
        {label: 'Оплачено', value: totals.monthPaid, hint: 'в ' ~ month|month_label|lower, dot: 'bg-success', href: path('admin_payment_index', filters|merge({month: month_key, status: 'paid'})) ~ '#list'},
    ] %}
    <div class="mb-6 grid gap-4 sm:grid-cols-2 xl:grid-cols-4" data-payment-totals>
        {% for kpi in kpis %}
            <a href="{{ kpi.href }}" class="card group !p-5 transition hover:-translate-y-0.5 hover:shadow-md">
                <div class="flex items-center gap-2 text-sm font-medium text-body">
                    <span class="size-2 rounded-full {{ kpi.dot }}"></span>{{ kpi.label }}
                    <span class="ms-auto rounded-md bg-zinc-100 px-1.5 py-0.5 text-xs font-semibold text-heading tabular-nums">{{ kpi.value.count }}</span>
                </div>
                <div class="mt-3 text-2xl font-semibold tracking-tight text-heading tabular-nums">{{ kpi.value.sum|money }}</div>
                <p class="mt-1 text-xs text-body-subtle">{{ kpi.hint }}</p>
            </a>
        {% endfor %}
    </div>

    {# Filters: search and client type; the month stays #}
    <form method="get" action="{{ path('admin_payment_index') }}" class="mb-6 flex flex-wrap items-center gap-3">
        <input type="hidden" name="month" value="{{ month_key }}">
        {% if status %}<input type="hidden" name="status" value="{{ status.value }}">{% endif %}
        <label class="search-field max-w-sm flex-1">
            <span class="sr-only">Поиск</span>
            {{ ui.icon('search') }}
            <input type="search" name="q" value="{{ q }}" class="input" autocomplete="off" placeholder="Клиент, ИНН или назначение…">
        </label>
        <div class="flex flex-wrap gap-2">
            {% set chip = 'inline-flex h-8 items-center rounded-full border px-3 text-sm font-medium transition-colors' %}
            {% for option in [{value: null, label: 'Все клиенты'}]|merge(enum_cases('App\\Enum\\ClientType')|map(t => {value: t, label: t.label})) %}
                <a href="{{ path('admin_payment_index', filters|merge({month: month_key, type: option.value ? option.value.value : null})|filter(v => v is not null)) }}"
                   class="{{ chip }} {{ option.value == type ? 'border-zinc-900 bg-zinc-900 text-white' : 'border-default bg-white text-body hover:text-heading' }}">{{ option.label }}</a>
            {% endfor %}
        </div>
    </form>

    {# Overdue payments of every month #}
    {% if overdue is not empty %}
        <section id="overdue" class="mb-6">
            <h2 class="mb-3 flex items-center gap-2 text-lg font-semibold text-fg-danger-strong">
                {{ ui.icon('warning', 'size-5') }} Просрочены
                <span class="rounded-md bg-danger-soft px-1.5 py-0.5 text-xs font-semibold">{{ overdue|length }}</span>
            </h2>
            {{ include('admin/payment/_table.html.twig', {payments: overdue, return: 'calendar'}) }}
        </section>
    {% endif %}

    {# Calendar of the month #}
    <section class="card !p-0 mb-6 overflow-hidden" data-payment-calendar>
        <div class="flex flex-wrap items-center justify-between gap-3 px-5 py-4">
            <div class="flex items-center gap-2">
                <a href="{{ path('admin_payment_index', filters|merge({month: month|date_modify('-1 month')|date('Y-m')})) }}" class="btn btn-ghost btn-sm" aria-label="Предыдущий месяц">←</a>
                <h2 class="min-w-40 text-center text-lg font-semibold text-heading">{{ month|month_label }}</h2>
                <a href="{{ path('admin_payment_index', filters|merge({month: month|date_modify('+1 month')|date('Y-m')})) }}" class="btn btn-ghost btn-sm" aria-label="Следующий месяц">→</a>
                {% if month_key != now|date('Y-m') %}
                    <a href="{{ path('admin_payment_index', filters) }}" class="btn btn-secondary btn-sm">Сегодня</a>
                {% endif %}
            </div>
            <div class="flex flex-wrap gap-3 text-xs text-body">
                <span class="inline-flex items-center gap-1.5"><span class="size-3 rounded-xs border border-default bg-white"></span>Ожидается</span>
                <span class="inline-flex items-center gap-1.5"><span class="size-3 rounded-xs border border-warning-subtle bg-warning-soft"></span>Скоро срок</span>
                <span class="inline-flex items-center gap-1.5"><span class="size-3 rounded-xs border border-danger-subtle bg-danger-soft"></span>Просрочен</span>
                <span class="inline-flex items-center gap-1.5"><span class="size-3 rounded-xs border border-success-subtle bg-success-soft"></span>Оплачен</span>
            </div>
        </div>
        <div class="overflow-x-auto border-t border-default">
            <div class="grid min-w-[48rem] grid-cols-7">
                {% for weekday in ['Пн', 'Вт', 'Ср', 'Чт', 'Пт', 'Сб', 'Вс'] %}
                    <div class="border-b border-default bg-neutral-secondary-soft px-2 py-1.5 text-xs font-medium {{ loop.index > 5 ? 'text-fg-danger-strong' : 'text-body' }}">{{ weekday }}</div>
                {% endfor %}
                {% for week in weeks %}
                    {% for day in week %}
                        {% set shown = day.payments|slice(0, 3) %}
                        <div class="min-h-28 border-b border-default p-1.5 {{ not loop.last ? 'border-e' : '' }} {{ day.inMonth ? '' : 'bg-zinc-50/70' }}"
                             data-day="{{ day.date|date('Y-m-d') }}">
                            <div class="mb-1 flex items-center justify-between">
                                <span class="grid size-6 place-items-center rounded-full text-xs font-medium {{ day.today ? 'bg-zinc-900 text-white' : (day.inMonth ? 'text-heading' : 'text-body-subtle') }}">{{ day.date|date('j') }}</span>
                                {% if day.payments|length > 1 %}
                                    <span class="text-[10px] font-medium text-body-subtle tabular-nums">{{ (day.payments|reduce((s, p) => s + p.amount, 0))|money }}</span>
                                {% endif %}
                            </div>
                            <div class="space-y-1">
                                {% for payment in shown %}
                                    {% set payment_status = payment.statusAt(now) %}
                                    <a href="{{ path('admin_payment_edit', {id: payment.id}) }}"
                                       title="{{ payment.client.clientTitle }} — {{ payment.title }}: {{ payment.amount|money }} · {{ payment_status.label|lower }}"
                                       class="block rounded-sm border px-1.5 py-1 text-[11px] leading-tight transition {{ tones[payment_status.value] }}" data-payment-status="{{ payment_status.value }}">
                                        <span class="block truncate font-medium">{{ payment.client.clientTitle }}</span>
                                        <span class="block tabular-nums {{ payment_status.value == 'paid' ? 'line-through opacity-70' : '' }}">{{ payment.amount|money }}</span>
                                    </a>
                                {% endfor %}
                                {% if day.payments|length > shown|length %}
                                    <a href="#list" class="block px-1 text-[11px] font-medium text-body hover:text-heading">ещё {{ day.payments|length - shown|length }}</a>
                                {% endif %}
                            </div>
                        </div>
                    {% endfor %}
                {% endfor %}
            </div>
        </div>
    </section>

    {# Payments of the month #}
    <section id="list">
        <div class="mb-3 flex flex-wrap items-center justify-between gap-3">
            <h2 class="text-lg font-semibold text-heading">Платежи за {{ month|month_label|lower }}</h2>
            <div class="flex flex-wrap gap-2">
                {% set chip = 'inline-flex h-8 items-center rounded-full border px-3 text-sm font-medium transition-colors' %}
                {% for option in [{value: null, label: 'Все'}]|merge(enum_cases('App\\Enum\\PaymentStatus')|map(s => {value: s, label: s.label})) %}
                    <a href="{{ path('admin_payment_index', filters|merge({month: month_key, status: option.value ? option.value.value : null})|filter(v => v is not null)) }}#list"
                       class="{{ chip }} {{ option.value == status ? 'border-zinc-900 bg-zinc-900 text-white' : 'border-default bg-white text-body hover:text-heading' }}">{{ option.label }}</a>
                {% endfor %}
            </div>
        </div>
        {{ include('admin/payment/_table.html.twig', {payments: list, return: 'calendar', empty: status ? 'В этом месяце таких платежей нет.' : 'В этом месяце платежей нет. Составьте график из медиаплана или добавьте платёж.'}) }}
    </section>
{% endblock %}
