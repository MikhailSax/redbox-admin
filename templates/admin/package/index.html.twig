{% extends 'admin/layout.html.twig' %}
{% import 'admin/_icons.html.twig' as ui %}

{% block title %}Пакетные предложения — {{ parent() }}{% endblock %}

{% block content %}
    <div class="page-header">
        <div>
            <h1 class="page-title">Пакетные предложения</h1>
            <p class="page-subtitle">Наборы сторон по особой цене. На сайте клиент собирает пакет из сторон, свободных на выбранный период</p>
        </div>
        <a href="{{ path('admin_package_new') }}" class="btn btn-primary">{{ ui.icon('plus', 'size-4') }} Новый пакет</a>
    </div>

    <form method="get" action="{{ path('admin_package_index') }}" data-live-filter="package-results" class="mb-4 max-w-md">
        <label class="search-field">
            <span class="sr-only">Поиск</span>
            {{ ui.icon('search') }}
            <input type="search" name="q" value="{{ q }}" class="input" autocomplete="off" placeholder="Название…">
        </label>
    </form>

    <div id="package-results">
        {% block results %}
            {# Imported here too: renderBlock() (live filter) renders this block without the template top level #}
            {% import 'admin/_icons.html.twig' as ui %}
            {% set state_styles = {
                active: 'bg-success-soft text-fg-success-strong ring-success-subtle',
                scheduled: 'bg-warning-soft text-fg-warning ring-warning-subtle',
                finished: 'bg-zinc-100 text-body ring-zinc-200',
                disabled: 'bg-zinc-100 text-body-subtle ring-zinc-200',
            } %}
            {% set state_labels = {active: 'Действует', scheduled: 'Запланирован', finished: 'Завершён', disabled: 'Выключен'} %}

            <div class="table-card">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th scope="col" class="px-4 py-2.5">Пакет</th>
                            <th scope="col" class="px-4 py-2.5">Состав</th>
                            <th scope="col" class="px-4 py-2.5 text-right whitespace-nowrap">В месяц</th>
                            <th scope="col" class="px-4 py-2.5">Срок</th>
                            <th scope="col" class="px-4 py-2.5">Период</th>
                            <th scope="col" class="px-4 py-2.5 text-right">Заявок</th>
                            <th scope="col" class="px-4 py-2.5"><span class="sr-only">Действия</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for package in packages %}
                            {% set package_state = package.stateOn(now) %}
                            <tr class="{{ package_state in ['finished', 'disabled'] ? 'opacity-70' }}">
                                <th scope="row" class="px-4 py-3 font-normal">
                                    <a href="{{ path('admin_package_edit', {id: package.id}) }}" class="group block min-w-40">
                                        <span class="line-clamp-2 font-medium text-heading group-hover:underline">{{ package.title|highlight(q) }}</span>
                                        <span class="mt-0.5 inline-flex h-5 items-center rounded-md px-1.5 text-[11px] font-medium ring-1 ring-inset {{ state_styles[package_state] }}">{{ state_labels[package_state] }}</span>
                                    </a>
                                </th>
                                <td class="min-w-48 max-w-80 px-4 py-3">
                                    <ul class="space-y-0.5">
                                        {% for slot in package.slots %}
                                            <li class="text-heading">{{ slot.title }} × {{ slot.quantity }} <span class="text-xs text-body-subtle">· {{ slot.priceLabel }}</span></li>
                                        {% endfor %}
                                    </ul>
                                </td>
                                <td class="px-4 py-3 text-right font-medium text-heading tabular-nums whitespace-nowrap">
                                    {% set fixed = package.fixedMonthlyTotal %}
                                    {{ fixed is not null ? fixed|money : 'по прайсу' }}
                                    <div class="text-xs font-normal text-body-subtle">{{ package.sideCount|plural('сторона', 'стороны', 'сторон') }}</div>
                                </td>
                                <td class="px-4 py-3 whitespace-nowrap">{{ package.monthsLabel }}</td>
                                <td class="px-4 py-3 text-heading tabular-nums">
                                    <span class="whitespace-nowrap">{{ package.startsAt|date('d.m.Y') }} —</span>
                                    <span class="whitespace-nowrap {{ package.endsAt ? '' : 'text-body-subtle' }}">{{ package.endsAt ? package.endsAt|date('d.m.Y') : 'бессрочно' }}</span>
                                </td>
                                <td class="px-4 py-3 text-right tabular-nums">{{ leads[package.id] ?? 0 }}</td>
                                <td class="px-4 py-3">
                                    <div class="flex justify-end gap-1">
                                        <form method="post" action="{{ path('admin_package_toggle', {id: package.id}) }}">
                                            <input type="hidden" name="_token" value="{{ csrf_token('package-' ~ package.id) }}">
                                            <button type="submit" role="switch" aria-checked="{{ package.active ? 'true' : 'false' }}" title="{{ package.active ? 'Выключить' : 'Включить' }}"
                                                    class="me-1 mt-1.5 inline-flex h-5 w-9 shrink-0 items-center rounded-full p-0.5 transition-colors {{ package.active ? 'bg-zinc-900' : 'bg-zinc-300 hover:bg-zinc-400' }}">
                                                <span class="sr-only">{{ package.active ? 'Выключить' : 'Включить' }}</span>
                                                <span class="size-4 rounded-full bg-white shadow-sm transition-transform {{ package.active ? 'translate-x-4' : '' }}"></span>
                                            </button>
                                        </form>
                                        <a href="{{ path('admin_package_edit', {id: package.id}) }}" class="btn btn-secondary btn-sm">Изменить</a>
                                        {{ include('admin/_delete_form.html.twig', {
                                            action: path('admin_package_delete', {id: package.id}),
                                            token_id: 'delete-package-' ~ package.id,
                                            title: 'Удалить пакет?',
                                            confirm: 'Пакет «' ~ package.title ~ '» будет удалён и пропадёт с сайта. Заявки по нему останутся с ценами пакета.',
                                            button_class: 'btn-ghost btn-sm text-fg-danger hover:bg-danger-soft',
                                        }) }}
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="7" class="px-4 py-16 text-center">
                                    <span class="mx-auto mb-3 grid size-12 place-items-center rounded-full bg-violet-50 text-violet-500">{{ ui.icon('stack') }}</span>
                                    {% if q %}
                                        <p class="font-medium text-heading">Ничего не найдено</p>
                                        <p class="mt-1 text-sm text-body">Попробуйте изменить запрос.</p>
                                    {% else %}
                                        <p class="font-medium text-heading">Пакетов пока нет</p>
                                        <p class="mt-1 text-sm text-body">Например, суперсайт и 4 экрана по одной цене или экран в подарок к двум щитам. <a href="{{ path('admin_package_new') }}" class="font-medium text-heading underline">Создать пакет</a></p>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endblock %}
    </div>
{% endblock %}
