{# One notification: a link that marks it read and goes where it points #}
{% import 'admin/_icons.html.twig' as ui %}
<a href="{{ path('admin_notification_open', {id: notification.id}) }}" class="flex gap-3 px-4 py-3 hover:bg-zinc-50 {{ notification.read ? '' : 'bg-violet-50/60' }}">
    <span class="grid size-8 shrink-0 place-items-center rounded-full {{ notification.read ? 'bg-zinc-100 text-zinc-500' : 'bg-violet-100 text-violet-700' }}">
        {{ ui.icon(notification.type.icon, 'size-4') }}
    </span>
    <span class="min-w-0 flex-1">
        <span class="block text-sm {{ notification.read ? 'text-body' : 'font-semibold text-heading' }}">{{ notification.title }}</span>
        {% if notification.body %}<span class="block truncate text-xs text-body-subtle">{{ notification.body }}</span>{% endif %}
        <span class="mt-0.5 block text-xs text-zinc-400">{{ notification.createdAt|date('d.m.Y H:i') }}</span>
    </span>
    {% if not notification.read %}<span class="mt-1.5 size-2 shrink-0 rounded-full bg-violet-600" aria-label="Не прочитано"></span>{% endif %}
</a>
