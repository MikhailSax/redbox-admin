{# Status badge of `booking` as of `now`, plus the payment mark of a confirmed booking #}
{% set status = booking.statusAt(now) %}
{% set classes = {
    hold: 'bg-warning-soft border-warning-subtle text-fg-warning',
    confirmed: 'bg-success-soft border-success-subtle text-fg-success-strong',
    cancelled: 'bg-neutral-secondary-medium border-default-medium text-body',
    expired: 'bg-neutral-secondary-medium border-default-medium text-body',
} %}
<span class="inline-flex items-center whitespace-nowrap text-xs font-medium px-1.5 py-0.5 rounded-sm border {{ classes[status.value] }}">{{ status.label }}</span>
{% if status.value == 'hold' %}
    {% set hours_left = ((booking.expiresAt.timestamp - now.timestamp) / 3600)|round(0, 'floor') %}
    <div class="text-xs text-body mt-1 whitespace-nowrap" title="Без подтверждения или оплаты бронь снимется автоматически">
        до {{ booking.expiresAt|date('d.m H:i') }} · {{ hours_left > 0 ? 'осталось ' ~ hours_left ~ ' ч' : 'меньше часа' }}
    </div>
{% elseif status.value == 'confirmed' %}
    {% if booking.paid %}
        <div class="mt-1"><span class="inline-flex items-center gap-1 whitespace-nowrap text-xs font-medium text-fg-success-strong" title="Оплачена {{ booking.paidAt|date('d.m.Y H:i') }}"><span class="size-1.5 rounded-full bg-success"></span>Оплачена {{ booking.paidAt|date('d.m.Y') }}</span></div>
    {% else %}
        <div class="mt-1"><span class="inline-flex items-center gap-1 whitespace-nowrap text-xs font-medium text-fg-danger-strong"><span class="size-1.5 rounded-full bg-danger"></span>Не оплачена</span></div>
    {% endif %}
{% endif %}
