{% extends 'admin/layout.html.twig' %}

{# Number of bookings on a month tab #}
{% macro tab_count(count) %}
    <span class="inline-flex items-center justify-center min-w-5 h-5 px-1 text-xs font-semibold rounded-full {{ count ? 'bg-brand-softer text-fg-brand-strong' : 'bg-neutral-tertiary text-body-subtle' }}">{{ count }}</span>
{% endmacro %}

{% block title %}Бронирование: {{ product.name }} — {{ parent() }}{% endblock %}

{% block content %}
    {#
        Buttons in the grids and the bookings list (confirm, pay, price, services…) are sent without a reload
        (assets/admin/ajax-forms.js): the [data-ajax-region] blocks are swapped. The new booking form reloads the page.
    #}
    <div id="booking-header" data-ajax-region>
        {{ include('admin/product/_card_header.html.twig', {active_tab: 'booking', in_form: false}) }}
    </div>

    <p class="text-sm text-body mb-4">
        {% if mixed %}
            Стороны продаются по-разному: {{ grids[0].sides|map(s => s.name)|join(', ') }} — эфиром по дням (слоты блока, от {{ minDays }} дней), {{ grids[1].sides|map(s => s.name)|join(', ') }} — целиком на календарный месяц.
        {% else %}
            {{ airtime ? 'Продаётся эфиром по дням: клиент берёт слоты блока, от ' ~ minDays ~ ' дней.' : 'Сторона бронируется целиком на календарный месяц.' }}
        {% endif %}
    </p>

    {# Occupancy grids: airtime sides × days, whole sides × months. A free cell fills the new booking form (assets/admin/booking-grid.js) #}
    {% set can_book = product.working %}
    <div id="booking-grids" data-ajax-region>
    {% for group in grids %}
    {% set grid_airtime = group.airtime %}
    <div class="card !p-0 mb-6 overflow-hidden">
        <div class="flex flex-wrap items-center justify-between gap-3 px-6 pt-5 pb-4">
            <h2 class="text-lg font-semibold text-heading">{{ grid_airtime ? 'Занятость эфира на ' ~ group.columns|length ~ ' дней' : 'Занятость на 12 месяцев' }}</h2>
            <div class="flex flex-wrap gap-3 text-xs text-body">
                <span class="inline-flex items-center gap-1.5"><span class="w-3 h-3 rounded-xs bg-success-soft border border-success-subtle"></span>Свободно</span>
                <span class="inline-flex items-center gap-1.5"><span class="w-3 h-3 rounded-xs bg-warning-soft border border-warning-subtle"></span>{{ grid_airtime ? 'Частично занято' : 'Ждёт подтверждения' }}</span>
                <span class="inline-flex items-center gap-1.5"><span class="w-3 h-3 rounded-xs bg-danger-soft border border-danger-subtle"></span>{{ grid_airtime ? 'Весь блок занят' : 'Подтверждена' }}</span>
            </div>
        </div>
        <div class="overflow-x-auto border-t border-default">
            <table class="w-full text-sm text-body">
                <thead class="bg-neutral-secondary-soft border-b border-default">
                    <tr>
                        <th scope="col" class="sticky left-0 bg-neutral-secondary-soft px-4 py-2 text-left font-medium">Сторона</th>
                        {% for column in group.columns %}
                            <th scope="col" class="px-1 py-2 font-medium text-center whitespace-nowrap {{ column.weekend ? 'text-fg-danger-strong' : '' }}">
                                {% if column.sub %}<div class="text-[10px] font-normal leading-none text-body-subtle">{{ column.sub }}</div>{% endif %}
                                {{ column.label }}
                            </th>
                        {% endfor %}
                    </tr>
                </thead>
                <tbody>
                    {% for side in group.sides %}
                        <tr class="border-b border-default last:border-0">
                            <th scope="row" class="sticky left-0 bg-neutral-primary-soft px-4 py-2 text-left font-medium text-heading whitespace-nowrap">
                                {{ side.name }}
                                {% if not side.working %}<div class="text-[11px] font-medium text-fg-danger-strong" title="{{ side.notWorkingReason }}">не работает</div>{% endif %}
                                {% if grid_airtime %}<div class="text-[11px] font-normal text-body-subtle">{{ side.slotCount }} × {{ side.slotSeconds }} сек{% if side.loopSlotCount and side.loopSlotCount > side.slotCount %} из {{ side.loopSlotCount }}{% endif %}</div>{% endif %}
                            </th>
                            {% for key, column in group.columns %}
                                {% set cell = group.cells[side.id][key] %}
                                {% set clients = cell.bookings|map(b => b.clientTitle ~ (airtime_label(b) ? ' (' ~ airtime_label(b) ~ ')' : '') ~ ' — ' ~ b.statusAt(now).label)|join("\n") %}
                                {# A cell with room left fills the form; a taken one leads to its booking in the list #}
                                {% set bookable = can_book and side.working %}
                                {% set booking = cell.bookings|first %}
                                {% set month_key = key|slice(0, 7) %}
                                {% set cell_link = booking ? path('admin_booking_product', {id: product.id, month: month_key}) ~ '#booking-' ~ booking.id %}
                                <td class="p-1">
                                    {% if grid_airtime %}
                                        {# cell.used is seconds of the block: half a 10-second slot sold leaves the other half free #}
                                        {% set used = min(cell.used, side.blockSeconds) %}
                                        {% set percent = (used * 100 / side.blockSeconds)|round(0, 'floor') %}
                                        {% set tone = used >= side.blockSeconds ? 'bg-danger-soft border-danger-subtle text-fg-danger-strong' : (used > 0 ? 'bg-warning-soft border-warning-subtle text-fg-warning' : 'bg-success-soft border-success-subtle text-fg-success-strong') %}
                                        {% set title = 'Занято слотов: ' ~ slots_label(used, side.slotSeconds) ~ ' из ' ~ side.slotCount ~ ' (' ~ used ~ ' из ' ~ side.blockSeconds ~ ' сек)' ~ (clients ? "\n" ~ clients) %}
                                        {% set content %}
                                            <div class="text-xs font-medium whitespace-nowrap tabular-nums">{{ slots_label(used, side.slotSeconds) }}/{{ side.slotCount }}</div>
                                            <div class="mt-1 h-1 rounded-full bg-neutral-tertiary-medium overflow-hidden"><div class="h-full bg-current" style="width: {{ percent }}%"></div></div>
                                        {% endset %}
                                        {% if bookable and used < side.blockSeconds %}
                                            <button type="button" data-book-side="{{ side.id }}" data-book-from="{{ key }}"
                                                    class="block w-full rounded-sm border px-1.5 py-1 text-center cursor-pointer hover:ring-2 hover:ring-brand/40 {{ tone }}"
                                                    title="{{ title }}&#10;Нажмите — бронь с этого дня, ещё раз на другом дне — по какой">{{ content }}</button>
                                        {% elseif booking %}
                                            <a href="{{ cell_link }}" data-booking-link="booking-{{ booking.id }}" class="block rounded-sm border px-1.5 py-1 text-center hover:ring-2 hover:ring-current/30 {{ tone }}" title="{{ title }}">{{ content }}</a>
                                        {% else %}
                                            <div class="rounded-sm border px-1.5 py-1 text-center {{ tone }}" title="{{ title }}">{{ content }}</div>
                                        {% endif %}
                                    {% else %}
                                        {% if booking %}
                                            {% set confirmed = booking.status.value == 'confirmed' %}
                                            <a href="{{ cell_link }}" data-booking-link="booking-{{ booking.id }}"
                                               class="block rounded-sm border px-1.5 py-1 text-center text-xs font-medium truncate max-w-28 hover:ring-2 hover:ring-current/30 {{ confirmed ? 'bg-danger-soft border-danger-subtle text-fg-danger-strong' : 'bg-warning-soft border-warning-subtle text-fg-warning' }}" title="{{ clients }}&#10;Нажмите — к брони в списке">
                                                {{ booking.clientTitle }}
                                            </a>
                                        {% elseif bookable %}
                                            <button type="button" data-book-side="{{ side.id }}" data-book-from="{{ key }}"
                                                    class="block w-full rounded-sm border px-1.5 py-1 text-center text-xs cursor-pointer hover:ring-2 hover:ring-brand/40 bg-success-soft border-success-subtle text-fg-success-strong"
                                                    title="Нажмите — бронь с этого месяца, ещё раз на другом месяце — по какой">свободно</button>
                                        {% else %}
                                            <div class="rounded-sm border px-1.5 py-1 text-center text-xs bg-success-soft border-success-subtle text-fg-success-strong">свободно</div>
                                        {% endif %}
                                    {% endif %}
                                </td>
                            {% endfor %}
                        </tr>
                    {% else %}
                        <tr><td colspan="{{ group.columns|length + 1 }}" class="px-4 py-6 text-center">У конструкции нет сторон — добавьте их в карточке.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
    {% endfor %}
    </div>

    {% if can_book %}
        {# What was picked in the grid, kept in view while scrolling to the form (assets/admin/booking-grid.js) #}
        <div data-booking-pick class="hidden sticky bottom-4 z-30 mb-6 flex-wrap items-center gap-x-4 gap-y-2 rounded-lg border border-default bg-neutral-primary-soft px-4 py-3 text-sm shadow-lg" aria-live="polite">
            <div class="min-w-0">
                <div data-booking-pick-text class="font-medium text-heading"></div>
                <div class="text-xs text-body">Нажмите на ячейку той же стороны дальше по сетке — это будет конец брони</div>
            </div>
            <div class="ms-auto flex gap-2">
                <button type="button" class="btn btn-ghost btn-sm" data-booking-pick-reset>Сбросить</button>
                <button type="button" class="btn btn-primary btn-sm" data-booking-pick-go>Оформить бронь</button>
            </div>
        </div>
    {% endif %}

    {% set not_working = product.notWorkingSides %}
    {% if not_working is not empty %}
        <div class="mb-6 rounded-lg border border-danger-subtle bg-danger-soft px-4 py-3 text-sm text-fg-danger-strong" role="status">
            <b>Не работает:</b>
            {% for side in not_working %}сторона {{ side.name }}{% if side.notWorkingReason %} ({{ side.notWorkingReason }}){% endif %}{{ not loop.last ? ', ' }}{% endfor %}.
            Новые брони на {{ not_working|length > 1 ? 'эти стороны' : 'эту сторону' }} не принимаются; уже сделанные остаются.
            Снова принимать брони — отметьте «Работает» у стороны в карточке конструкции.
        </div>
    {% endif %}

    {# Agents book too (24h holds); confirming, payments, prices and services are for managers. Sides out of order take no new bookings #}
    {% set is_manager = is_granted('ROLE_SUPER_MANAGER') %}
    {% if product.working %}
    <div class="grid gap-6 lg:grid-cols-3 mb-6">
        {# New booking #}
        <div id="new-booking" class="card lg:col-span-2 scroll-mt-4">
            <h2 class="text-lg font-semibold text-heading mb-4">Новая бронь</h2>
            {% form_theme form 'admin/form/theme.html.twig' %}
            {{ form_start(form, {attr: {novalidate: 'novalidate', 'data-booking-form': '', 'data-min-days': minDays}}) }}
                {% if form.vars.errors|length %}
                    <div class="flex items-start gap-3 p-4 mb-5 text-sm rounded-base border text-fg-danger-strong bg-danger-soft border-danger-subtle" role="alert">
                        {{ form_errors(form) }}
                    </div>
                {% endif %}
                {# When sides are booked differently, assets/admin/booking-mode.js shows the fields of the chosen side #}
                {% set airtime_row = mixed ? {row_attr: {'data-booking-mode': 'airtime'}} : {} %}
                {% set whole_row = mixed ? {row_attr: {'data-booking-mode': 'side'}} : {} %}
                <div class="grid gap-x-6 md:grid-cols-3">
                    {{ form_row(form.side, mixed ? {attr: {'data-booking-mode-source': ''}} : {}) }}
                    {% if form.startDate is defined %}
                        {{ form_row(form.startDate, airtime_row) }}
                        {{ form_row(form.endDate, airtime_row) }}
                    {% endif %}
                    {% if form.startMonth is defined %}
                        {{ form_row(form.startMonth, whole_row) }}
                        {{ form_row(form.months, whole_row) }}
                    {% endif %}
                </div>
                {% if form.slots is defined %}
                    <div class="grid gap-x-6 md:grid-cols-3">
                        {{ form_row(form.slots, airtime_row) }}
                        {% if form.slotSeconds is defined %}
                            <div class="md:col-span-2">{{ form_row(form.slotSeconds, airtime_row) }}</div>
                        {% endif %}
                    </div>
                {% endif %}
                {{ form_row(form.client) }}
                {{ include('admin/_new_client_fields.html.twig', {form: form}) }}
                <div class="grid gap-x-6 md:grid-cols-2">
                    {{ form_row(form.clientName) }}
                    {{ form_row(form.clientPhone) }}
                </div>
                {{ form_row(form.comment) }}
                {{ form_row(form.soldPrice) }}

                {# One-off services sold with the booking: rows added by assets/admin/collection.js #}
                <div class="mb-5">
                    <div class="flex flex-wrap items-center justify-between gap-3 mb-2">
                        <div>
                            <h3 class="text-sm font-medium text-heading">Услуги</h3>
                            <p class="text-xs text-body">Макет, печать, монтаж — разово, сверх «Продано за». Можно добавить и позже в списке броней.</p>
                        </div>
                        <button type="button" class="btn btn-secondary btn-sm" data-collection-add="booking-services">+ Добавить услугу</button>
                    </div>
                    <div id="booking-services" class="space-y-3" data-index="{{ form.services|length }}"
                         data-prototype="{{ include('admin/booking/_service_row.html.twig', {line: form.services.vars.prototype})|e('html_attr') }}">
                        {% for line in form.services %}
                            {{ include('admin/booking/_service_row.html.twig') }}
                        {% endfor %}
                    </div>
                    {% do form.services.setRendered %}
                </div>
                {{ include('admin/_service_units.html.twig') }}
                <button type="submit" class="btn btn-primary">Забронировать на 24 часа</button>
            {{ form_end(form) }}
        </div>

        <div class="card">
            <h2 class="text-lg font-semibold text-heading mb-3">Как работает бронь</h2>
            <ul class="space-y-3 text-sm text-body list-disc ps-5">
                <li>Новая бронь держит место <b class="text-heading">24 часа</b>. Если за это время её не подтвердить и не отметить оплату, бронь снимается автоматически и место освобождается.</li>
                {% if airtime %}
                    <li>Эфир продаётся <b class="text-heading">по дням</b>: с любого дня по любой, включительно, но не меньше <b class="text-heading">{{ minDays }} дней</b>.</li>
                    <li>Блок экрана делится на <b class="text-heading">слоты</b>. Клиент берёт один или несколько слотов — целиком или по 5 сек из слота в 10 сек (вторая половина остаётся свободной). Слот занят, когда выкуплено всё его время, экран — когда весь блок. В сетке — сколько слотов занято в этот день.</li>
                {% endif %}
                {% if whole %}
                    <li>{{ mixed ? 'Статичная сторона' : 'Сторона' }} бронируется целиком на календарный месяц — одному клиенту.</li>
                {% endif %}
                {% if is_manager %}
                    <li>«Подтвердить» закрепляет бронь без оплаты — для постоплатников; оплату отметьте «Оплачено», когда придут деньги. «Оплачено» у неподтверждённой брони сразу и подтверждает её.</li>
                {% else %}
                    <li>Подтверждает бронь и отмечает оплату менеджер — сообщите ему о брони, пока не прошли 24 часа.</li>
                {% endif %}
            </ul>
        </div>
    </div>

    {# All bookings of the product; a row is the target of its cell in the grid (#booking-ID) #}
    <section id="booking-list" data-ajax-forms data-ajax-region>
    <h2 id="bookings" class="text-xl font-semibold text-heading mb-4 scroll-mt-4">Брони конструкции</h2>
    {# Month tabs: bookings that take at least a day of the month; "Все" — the whole list #}
    {% set tab_css = 'inline-flex items-center gap-2 px-4 py-3 border-b-2 rounded-t-base' %}
    {% set tab_active = 'text-fg-brand border-brand' %}
    {% set tab_inactive = 'border-transparent text-body hover:text-heading hover:border-default-strong' %}
    <nav class="mb-4 overflow-x-auto overflow-y-hidden border-b border-default" aria-label="Брони по месяцам">
        <ul class="flex -mb-px text-sm font-medium text-center whitespace-nowrap">
            <li class="me-1">
                <a href="{{ path('admin_booking_product', {id: product.id, month: 'all'}) }}#bookings"
                   class="{{ tab_css }} {{ monthTab == 'all' ? tab_active : tab_inactive }}"{% if monthTab == 'all' %} aria-current="page"{% endif %}>
                    Все {{ _self.tab_count(allBookings) }}
                </a>
            </li>
            {% for key, tab in monthTabs %}
                <li class="me-1">
                    <a href="{{ path('admin_booking_product', {id: product.id, month: key}) }}#bookings"
                       class="{{ tab_css }} {{ key == monthTab ? tab_active : tab_inactive }}"{% if key == monthTab %} aria-current="page"{% endif %}
                       {% if key == now|date('Y-m') %}title="Текущий месяц"{% endif %}>
                        {{ tab.month|month_label }} {{ _self.tab_count(tab.count) }}
                    </a>
                </li>
            {% endfor %}
        </ul>
    </nav>
    {# the tab that opens by default needs no carrying back after an action #}
    {% set return_month = monthTab != defaultMonthTab ? monthTab %}
    <div class="table-card">
        <table class="data-table">
            <thead>
                <tr>
                    <th scope="col" class="px-4 py-3 font-medium">Сторона</th>
                    <th scope="col" class="px-4 py-3 font-medium">Период</th>
                    <th scope="col" class="px-4 py-3 font-medium">Клиент</th>
                    <th scope="col" class="px-4 py-3 font-medium">Статус</th>
                    {% if is_manager %}
                        <th scope="col" class="px-4 py-3 font-medium">Продано за</th>
                        <th scope="col" class="px-4 py-3 font-medium">Услуги</th>
                        <th scope="col" class="px-4 py-3 font-medium"><span class="sr-only">Действия</span></th>
                    {% endif %}
                </tr>
            </thead>
            <tbody>
                {% for booking in bookings %}
                    <tr id="booking-{{ booking.id }}" class="scroll-mt-24 target:bg-brand-softer">
                        <td class="px-4 py-3 font-medium text-heading">{{ booking.side.name }}</td>
                        <td class="px-4 py-3 whitespace-nowrap"><a href="{{ path('admin_booking_show', {id: booking.id}) }}" class="group block" title="Открыть карточку брони"><span class="font-medium text-heading group-hover:underline">{{ include('admin/booking/_period.html.twig') }}</span></a></td>
                        <td class="px-4 py-3">
                            {{ include('admin/booking/_client.html.twig') }}
                            {% if booking.createdBy %}<div class="text-xs text-body-subtle">оформил(а) {{ booking.createdBy.name }}</div>{% endif %}
                            {% if booking.comment %}<div class="text-xs mt-1">{{ booking.comment }}</div>{% endif %}
                        </td>
                        <td class="px-4 py-3">{{ include('admin/booking/_status.html.twig') }}</td>
                        {% if is_manager %}
                            <td class="px-4 py-3">{{ include('admin/booking/_sold.html.twig', {return: 'product'}) }}</td>
                            <td class="px-4 py-3">{{ include('admin/booking/_services.html.twig', {service_form: serviceForms[booking.id] ?? null}) }}</td>
                            <td class="px-4 py-3">{{ include('admin/booking/_actions.html.twig', {return: 'product'}) }}</td>
                        {% endif %}
                    </tr>
                {% else %}
                    <tr><td colspan="{{ is_manager ? 7 : 4 }}" class="px-4 py-8 text-center">{{ monthTab == 'all' or allBookings == 0 ? 'Броней пока нет.' : 'В этом месяце броней нет.' }}</td></tr>
                {% endfor %}
            </tbody>
            {% if is_manager and bookings is not empty %}
                {# Revenue of the tab: bookings in force only; a month takes its share of a longer booking by days #}
                <tfoot class="bg-neutral-secondary-soft border-t border-default">
                    <tr data-revenue>
                        <th scope="row" colspan="4" class="px-4 py-3 text-right font-medium text-heading">
                            {{ monthTab == 'all' ? 'Выручка за всё время' : 'Выручка за ' ~ (monthTabs[monthTab].month|month_label|lower) }}
                            <div class="text-xs font-normal text-body-subtle">
                                действующие брони{{ monthTab != 'all' ? '; бронь на несколько месяцев — долей по дням, услуги — в месяц начала брони' }}
                            </div>
                        </th>
                        <td colspan="3" class="px-4 py-3">
                            <dl class="text-xs text-body tabular-nums">
                                <div class="flex justify-between gap-3 max-w-56"><dt>Размещение</dt><dd class="whitespace-nowrap">{{ revenue.placement|money }}</dd></div>
                                <div class="flex justify-between gap-3 max-w-56"><dt>Услуги</dt><dd class="whitespace-nowrap">{{ revenue.services|money }}</dd></div>
                            </dl>
                            <div class="mt-1 text-base font-semibold text-heading whitespace-nowrap tabular-nums">Итого {{ revenue.total|money }}</div>
                            <div class="text-xs text-body whitespace-nowrap tabular-nums">оплачено {{ revenue.paid|money }}</div>
                            {% if revenue.unpriced %}<div class="text-xs text-fg-warning">без суммы: {{ revenue.unpriced }}</div>{% endif %}
                        </td>
                    </tr>
                </tfoot>
            {% endif %}
        </table>
    </div>
    </section>
    {% endif %}
{% endblock %}
