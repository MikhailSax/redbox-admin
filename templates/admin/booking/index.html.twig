{% extends 'admin/layout.html.twig' %}
{% import 'admin/_icons.html.twig' as ui %}

{% block title %}Брони — {{ parent() }}{% endblock %}

{% block content %}
    <div class="page-header">
        <div>
            <h1 class="page-title">Брони</h1>
            <p class="page-subtitle">Неподтверждённая бронь держит место 24 часа, затем снимается автоматически. Постоплатникам бронь подтверждают, а оплату отмечают позже</p>
        </div>
    </div>

    <form method="get" action="{{ path('admin_booking_index') }}" data-live-filter="booking-results" class="mb-4 max-w-md">
        <label class="search-field">
            <span class="sr-only">Поиск</span>
            {{ ui.icon('search') }}
            <input type="search" name="q" value="{{ q }}" class="input" autocomplete="off" placeholder="Клиент, телефон или конструкция…">
        </label>
        <input type="hidden" name="status" value="{{ unpaid ? 'unpaid' : (filter ? filter.value : '') }}">
        <input type="hidden" name="sort" value="{{ sort != 'created' ? sort : '' }}">
        <input type="hidden" name="dir" value="{{ descending != (sort == 'created') ? (descending ? 'desc' : 'asc') : '' }}">
    </form>

    <div id="booking-results">
        {% block results %}
            {# Imported here too: renderBlock() (live filter) renders this block without the template top level #}
            {% import 'admin/_icons.html.twig' as ui %}
            {% set sorting = (sort != 'created' ? {sort: sort} : {})|merge(descending != (sort == 'created') ? {dir: descending ? 'desc' : 'asc'} : {}) %}
            {% set base = (q ? {q: q} : {})|merge(sorting) %}
            {% set status_query = unpaid ? {status: 'unpaid'} : (filter ? {status: filter.value} : {}) %}
            <div class="mb-4 flex flex-wrap gap-2">
                {% set chip = 'inline-flex h-8 items-center rounded-full border px-3 text-sm font-medium transition-colors' %}
                {% for tab in [{value: null, label: 'Все'}]|merge(enum_cases('App\\Enum\\BookingStatus')|map(s => {value: s, label: s.label})) %}
                    <a href="{{ path('admin_booking_index', tab.value ? base|merge({status: tab.value.value}) : base) }}" data-live-link
                       class="{{ chip }} {{ tab.value == filter and not unpaid ? 'border-zinc-900 bg-zinc-900 text-white' : 'border-default bg-white text-body hover:text-heading' }}">{{ tab.label }}</a>
                {% endfor %}
                <a href="{{ path('admin_booking_index', base|merge({status: 'unpaid'})) }}" data-live-link title="Подтверждённые брони постоплатников, по которым ещё нет оплаты"
                   class="{{ chip }} {{ unpaid ? 'border-zinc-900 bg-zinc-900 text-white' : 'border-default bg-white text-body hover:text-heading' }}">Подтверждены, не оплачены</a>
            </div>

            <div class="table-card">
                <table class="data-table">
                    <thead>
                        <tr>
                            {# Sortable columns: a click sorts by the column, a second click turns the order around #}
                            {% for column in [
                                {key: 'product', label: 'Конструкция'},
                                {key: 'side', label: 'Сторона'},
                                {key: 'period', label: 'Период'},
                                {key: 'client', label: 'Клиент'},
                                {key: 'status', label: 'Статус'},
                                {key: 'created', label: 'Создана'},
                            ] %}
                                {% set active = sort == column.key %}
                                {# the newest first by the creation date, A to Z / the earliest first by the others #}
                                {% set next_desc = active ? not descending : column.key == 'created' %}
                                {% set query = (q ? {q: q} : {})|merge(status_query)
                                    |merge(column.key != 'created' ? {sort: column.key} : {})
                                    |merge(next_desc != (column.key == 'created') ? {dir: next_desc ? 'desc' : 'asc'} : {}) %}
                                <th scope="col" class="px-4 py-2.5" {% if active %}aria-sort="{{ descending ? 'descending' : 'ascending' }}"{% endif %}>
                                    <a href="{{ path('admin_booking_index', query) }}" data-live-link class="inline-flex items-center gap-1 hover:text-heading {{ active ? 'text-heading' : '' }}">
                                        {{- column.label -}}
                                        <span aria-hidden="true" class="{{ active ? '' : 'opacity-30' }}">{{ active and descending ? '↓' : '↑' }}</span>
                                    </a>
                                </th>
                            {% endfor %}
                            <th scope="col" class="px-4 py-2.5"><span class="sr-only">Действия</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for booking in bookings %}
                            <tr>
                                <th scope="row" class="px-4 py-3 font-medium text-heading">
                                    <a href="{{ path('admin_booking_product', {id: booking.product.id}) }}" class="hover:underline">{{ booking.product.name|highlight(q) }}</a>
                                </th>
                                <td class="px-4 py-3 whitespace-nowrap">
                                    <span class="inline-flex min-w-7 justify-center rounded-md bg-zinc-100 px-1.5 py-0.5 text-sm font-semibold text-heading ring-1 ring-zinc-200">{{ booking.side.name }}</span>
                                </td>
                                <td class="px-4 py-3 whitespace-nowrap">{{ include('admin/booking/_period.html.twig') }}</td>
                                <td class="px-4 py-3">{{ include('admin/booking/_client.html.twig') }}</td>
                                <td class="px-4 py-3">{{ include('admin/booking/_status.html.twig') }}</td>
                                <td class="px-4 py-3 whitespace-nowrap">
                                    {{ booking.createdAt|date('d.m.Y H:i') }}
                                    {% if booking.createdBy %}<div class="text-xs text-body-subtle">{{ booking.createdBy.name }}</div>{% endif %}
                                </td>
                                <td class="px-4 py-3">{{ include('admin/booking/_actions.html.twig', {return: 'list'}) }}</td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="7" class="px-4 py-16 text-center">
                                    <span class="mx-auto mb-3 grid size-12 place-items-center rounded-full bg-zinc-100 text-zinc-400">{{ ui.icon('calendar') }}</span>
                                    <p class="font-medium text-heading">{{ q or filter or unpaid ? 'Ничего не найдено' : 'Броней пока нет' }}</p>
                                    <p class="mt-1 text-sm text-body">Забронировать конструкцию можно из её карточки — вкладка «Бронирование».</p>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endblock %}
    </div>
{% endblock %}
