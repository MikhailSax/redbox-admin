{% extends 'admin/layout.html.twig' %}
{% import 'admin/_icons.html.twig' as ui %}

{% block title %}Конструкции — {{ parent() }}{% endblock %}

{% block content %}
    <div class="page-header">
        <div>
            <h1 class="page-title">Конструкции</h1>
            <p class="page-subtitle">Свои и партнёрские рекламные конструкции и их занятость</p>
        </div>
        {% if is_granted('ROLE_SUPER_MANAGER') %}
            <a href="{{ path('admin_product_new') }}" class="btn btn-primary">{{ ui.icon('plus', 'size-4') }} Добавить</a>
        {% endif %}
    </div>

    {# Filters apply as you type / choose (assets/admin/live-filter.js); without JS the form still submits normally #}
    <form method="get" action="{{ path('admin_product_index') }}" data-live-filter="product-results"
          class="mb-4 flex flex-wrap items-center gap-2">
        <label class="search-field w-full sm:w-64">
            <span class="sr-only">Поиск</span>
            {{ ui.icon('search') }}
            <input type="search" name="q" value="{{ query.q }}" class="input" autocomplete="off"
                   placeholder="Название, район, категория…" data-live-filter-input>
        </label>
        <select name="category" class="filter" aria-label="Категория">
            <option value="">Все категории</option>
            {% for category in categories %}
                <option value="{{ category.id }}" {{ query.category == category.id ? 'selected' }}>{{ category.name }}</option>
            {% endfor %}
        </select>
        <select name="type" class="filter" aria-label="Тип">
            <option value="">Все типы</option>
            {% for type in types %}
                <option value="{{ type.id }}" {{ query.type == type.id ? 'selected' }}>{{ type.name }}</option>
            {% endfor %}
        </select>
        <select name="owner" class="filter" aria-label="Владелец">
            <option value="">Все владельцы</option>
            <option value="own" {{ query.owner == "own" ? "selected" }}>Свои конструкции</option>
            {% for partner in partners %}
                <option value="{{ partner.id }}" {{ query.owner == partner.id ~ "" ? "selected" }}>{{ partner.name }}</option>
            {% endfor %}
        </select>
        <select name="working" class="filter" aria-label="Работает">
            <option value="">Работающие и нет</option>
            <option value="yes" {{ query.working == 'yes' ? 'selected' }}>Работают</option>
            <option value="no" {{ query.working == 'no' ? 'selected' }}>Не работают</option>
        </select>
        <select name="month" class="filter" aria-label="Статус на месяц">
            {% for m in months %}
                <option value="{{ loop.first ? '' : m|date('Y-m') }}" {{ m|date('Y-m') == month|date('Y-m') ? 'selected' }}>{{ loop.first ? 'Сейчас · ' : '' }}{{ m|month_label }}</option>
            {% endfor %}
        </select>
        <input type="hidden" name="status" value="{{ query.status }}">
        <input type="hidden" name="sort" value="{{ query.sort }}">
        <input type="hidden" name="dir" value="{{ query.dir }}">
        <noscript><button type="submit" class="btn btn-primary">Найти</button></noscript>
    </form>

    <div id="product-results">
        {% block results %}
            {# Imported here too: renderBlock() (live filter) renders this block without the template top level #}
            {% import 'admin/_icons.html.twig' as ui %}
            {% set selected_month = month|date('Y-m') %}
            {# Query params kept by pagination and the status chips #}
            {% set filters = {
                q: query.q,
                category: query.category,
                type: query.type,
                month: selected_month != months|first|date('Y-m') ? selected_month : null,
                owner: query.owner,
                working: query.working,
                status: query.status,
                sort: query.sort,
                dir: query.dir,
            }|filter(v => v is not null and v != '') %}
            {% set tones = {
                free: 'bg-success-soft border-success-subtle text-fg-success-strong',
                booked: 'bg-warning-soft border-warning-subtle text-fg-warning',
                occupied: 'bg-danger-soft border-danger-subtle text-fg-danger-strong',
            } %}
            {% set dots = {free: 'bg-success', booked: 'bg-warning', occupied: 'bg-danger'} %}

            {# Status chips with counts #}
            <div class="mb-4 flex flex-wrap items-center gap-2">
                {% set chip = 'chip' %}
                <a href="{{ path('admin_product_index', filters|filter((v, k) => k != 'status')) }}" data-live-link
                   class="{{ chip }} {{ query.status ? '' : 'chip-on' }}">
                    Все <span class="chip-count">{{ statusCounts|reduce((sum, n) => sum + n, 0) }}</span>
                </a>
                {% for status in enum_cases('App\\Enum\\AvailabilityStatus') %}
                    {% set active = query.status == status.value %}
                    <a href="{{ path('admin_product_index', filters|merge({status: status.value})) }}" data-live-link
                       class="{{ chip }} {{ active ? 'chip-on' : '' }}">
                        <span class="size-2 rounded-full {{ dots[status.value] }}"></span>
                        {{ {free: 'Свободны', booked: 'Забронированы', occupied: 'Заняты'}[status.value] }}
                        <span class="chip-count">{{ statusCounts[status.value] }}</span>
                    </a>
                {% endfor %}
                <span class="ms-auto text-sm text-body-subtle">
                    {{ total }} {{ total % 10 == 1 and total % 100 != 11 ? 'конструкция' : (total % 10 in [2, 3, 4] and total % 100 not in [12, 13, 14] ? 'конструкции' : 'конструкций') }}
                    · статус на {{ month|month_label|lower }}
                </span>
            </div>

            <div class="table-card">
                <table class="data-table">
                    <thead>
                        <tr>
                            {# Sortable columns: a click sorts A to Z (free first, the cheapest first), a second click turns it around, a third goes back to the recently updated #}
                            {% for column in [
                                {key: 'name', label: 'Конструкция'},
                                {key: 'status', label: 'Статус'},
                                {key: null, label: 'Стороны'},
                                {key: 'district', label: 'Район'},
                                {key: 'price', label: 'Цена / мес.', css: 'text-right'},
                            ] %}
                                {% set active = column.key and query.sort == column.key %}
                                <th scope="col" class="px-4 py-2.5 {{ column.css|default('') }}" {% if active %}aria-sort="{{ query.dir == 'desc' ? 'descending' : 'ascending' }}"{% endif %}>
                                    {% if column.key %}
                                        {% set sorting = not active ? {sort: column.key} : (query.dir != 'desc' ? {sort: column.key, dir: 'desc'} : {}) %}
                                        <a href="{{ path('admin_product_index', filters|filter((v, k) => k not in ['sort', 'dir', 'page'])|merge(sorting)) }}" data-live-link
                                           class="inline-flex items-center gap-1 hover:text-heading {{ active ? 'text-heading' : '' }}">
                                            {{- column.label -}}
                                            <span aria-hidden="true" class="{{ active ? '' : 'opacity-30' }}">{{ active and query.dir == 'desc' ? '↓' : '↑' }}</span>
                                        </a>
                                    {% else %}
                                        {{ column.label }}
                                    {% endif %}
                                </th>
                            {% endfor %}
                            <th scope="col" class="px-4 py-2.5"><span class="sr-only">Действия</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for product in products %}
                            {% set cover = product.coverPhoto %}
                            {% set item = availability[product.id] %}
                            <tr>
                                <th scope="row" class="px-4 py-3 font-normal">
                                    <a href="{{ path('admin_product_edit', {id: product.id}) }}" class="group flex items-center gap-3">
                                        {% if cover %}
                                            <img src="{{ asset(cover.webPath) }}" alt="" class="h-11 w-16 shrink-0 rounded-lg object-cover ring-1 ring-black/5">
                                        {% else %}
                                            <span class="grid h-11 w-16 shrink-0 place-items-center rounded-lg bg-zinc-100 text-zinc-400">{{ ui.icon('billboard') }}</span>
                                        {% endif %}
                                        <span class="min-w-0">
                                            <span class="block truncate font-medium text-heading group-hover:underline">{{ product.name|highlight(query.q) }}</span>
                                            <span class="block truncate text-xs text-body-subtle">
                                                {%- if product.schemeNumber %}№{{ product.schemeNumber|highlight(query.q) }} · {% endif -%}
                                                {{ product.category.name|highlight(query.q) }} · {{ product.typeLabel }}
                                                {%- if product.size %} · {{ product.sizeLabel }}{% endif -%}
                                            </span>
                                            <span class="mt-1 flex flex-wrap items-center gap-1">
                                                {% set not_working = product.notWorkingSides %}
                                                {% if not_working is not empty %}
                                                    <span class="inline-flex items-center rounded bg-danger-soft px-1.5 py-px text-[11px] font-medium text-fg-danger-strong ring-1 ring-danger-subtle"
                                                          title="{{ not_working|map(s => 'Сторона ' ~ s.name ~ (s.notWorkingReason ? ': ' ~ s.notWorkingReason : ''))|join("\n") }}">
                                                        {{- not_working|length == product.sides|length ? 'Не работает' : 'Не работает: ' ~ not_working|map(s => s.name)|join(', ') -}}
                                                    </span>
                                                {% endif %}
                                                <span class="inline-flex items-center rounded px-1.5 py-px text-[11px] font-medium {{ product.own ? "bg-zinc-100 text-heading ring-1 ring-zinc-200" : "bg-sky-50 text-sky-700 ring-1 ring-sky-200" }}">{{ product.own ? "Своя" : product.owner.name }}</span>
                                                {% for promotion in promotions_for(product, true)|slice(0, 2) %}
                                                    <span class="promo-badge !h-[18px]" title="Акция «{{ promotion.title }}»">{{ promotion.discountLabel }}</span>
                                                {% endfor %}
                                            </span>
                                        </span>
                                    </a>
                                </th>
                                <td class="px-4 py-3" data-status="{{ item.status.value ?? '' }}">
                                    {{ include('admin/_availability_badge.html.twig', {status: item.status}) }}
                                </td>
                                <td class="px-4 py-3 whitespace-nowrap">
                                    <div class="flex gap-1">
                                        {% for side in item.sides %}
                                            {% set side_status = side.status %}
                                            {# a side out of order: struck through, it is not for sale; a working one opens its booking form on the month shown #}
                                            {% set chip_css = 'inline-flex h-6 min-w-6 items-center justify-center rounded-md border px-1.5 text-xs font-medium ' ~ tones[side_status.value] %}
                                            {% set chip_title = 'Сторона ' ~ side.sideName ~ ': ' ~ (side.working ? '' : 'не работает, ') ~ side_status.label|lower ~ (side.airtime ? ', занято слотов: ' ~ side.usedSlotsLabel ~ ' из ' ~ side.slotCount ~ ', свободно ' ~ side.freeSeconds ~ ' сек' : '') %}
                                            {% set chip_label %}{{ side.sideName }}{% if side.airtime %}<span class="ms-1 opacity-70 tabular-nums">{{ side.usedSlotsLabel }}/{{ side.slotCount }}</span>{% endif %}{% endset %}
                                            {% if side.working %}
                                                <a href="{{ path('admin_booking_product', {id: product.id, side: side.sideId, from: selected_month}) }}#new-booking"
                                                   class="{{ chip_css }} hover:ring-2 hover:ring-current/30" title="{{ chip_title }}&#10;Нажмите — забронировать с месяца «{{ month|month_label|lower }}»">{{ chip_label }}</a>
                                            {% else %}
                                                <span class="{{ chip_css }} line-through opacity-50" title="{{ chip_title }}">{{ chip_label }}</span>
                                            {% endif %}
                                        {% else %}
                                            <span class="text-body-subtle">—</span>
                                        {% endfor %}
                                    </div>
                                </td>
                                <td class="px-4 py-3">{{ product.district ? product.district.name|highlight(query.q) : '—' }}</td>
                                <td class="px-4 py-3 text-right font-medium text-heading tabular-nums whitespace-nowrap">
                                    {% if product.price is not null %}
                                        {% if product.sides|filter(s => s.price is not null) is not empty %}<span class="font-normal text-body-subtle" title="У сторон разные цены">от </span>{% endif -%}
                                        {{ product.price|number_format(product.price ends with ".00" ? 0 : 2, ",", " ") }}&nbsp;₽
                                        {% if product.margin is not null %}<div class="text-xs font-normal text-fg-success-strong" title="Маржа в месяц">+{{ product.margin|number_format(0, ",", " ") }}&nbsp;₽ · {{ product.marginPercent|round }}%</div>{% endif %}
                                    {% else %}
                                        <span class="font-normal text-body-subtle">—</span>
                                    {% endif %}
                                </td>
                                <td class="px-4 py-3">
                                    <div class="flex justify-end gap-1">
                                        {% set can_manage = is_granted('ROLE_SUPER_MANAGER') %}
                                        {# the name opens the card; here what is done most: booking #}
                                        <a href="{{ path('admin_booking_product', {id: product.id, from: selected_month}) }}" class="btn btn-secondary btn-sm">Бронирование</a>
                                        {% if can_manage %}
                                            <form method="post" action="{{ path('admin_product_delete', {id: product.id}) }}"
                                                  data-confirm="Конструкция «{{ product.name }}» будет удалена вместе со сторонами и фотографиями."
                                                  data-confirm-title="Удалить конструкцию?">
                                                <input type="hidden" name="_token" value="{{ csrf_token('delete-product-' ~ product.id) }}">
                                                <button type="submit" class="btn btn-ghost btn-sm text-body-subtle hover:bg-danger-soft hover:text-fg-danger-strong" title="Удалить конструкцию" aria-label="Удалить конструкцию «{{ product.name }}»">{{ ui.icon('x', 'size-4') }}</button>
                                            </form>
                                        {% endif %}
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="6" class="px-4 py-16 text-center">
                                    <span class="mx-auto mb-3 grid size-12 place-items-center rounded-full bg-zinc-100 text-zinc-400">{{ ui.icon('search') }}</span>
                                    {% if filters is not empty %}
                                        <p class="font-medium text-heading">Ничего не найдено</p>
                                        <p class="mt-1 text-sm text-body">Попробуйте изменить запрос или <a href="{{ path('admin_product_index') }}" class="font-medium text-heading underline">сбросить фильтры</a></p>
                                    {% else %}
                                        <p class="font-medium text-heading">Конструкций пока нет</p>
                                        {% if is_granted('ROLE_SUPER_MANAGER') %}
                                            <p class="mt-1 text-sm text-body"><a href="{{ path('admin_product_new') }}" class="font-medium text-heading underline">Добавьте первую</a></p>
                                        {% endif %}
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            {% if pages > 1 %}
                <nav aria-label="Страницы" class="mt-6 flex items-center justify-between gap-4">
                    <p class="text-sm text-body">Страница {{ query.page }} из {{ pages }}</p>
                    <ul class="flex gap-1 text-sm">
                        {% for p in 1..pages %}
                            {% if p == 1 or p == pages or (p - query.page)|abs <= 2 %}
                                <li>
                                    <a href="{{ path('admin_product_index', filters|merge({page: p})) }}" data-live-link
                                       {% if p == query.page %}aria-current="page"{% endif %}
                                       class="grid h-8 min-w-8 place-items-center rounded-lg px-2 font-medium tabular-nums {{ p == query.page ? 'bg-zinc-900 text-white' : 'text-body hover:bg-zinc-100 hover:text-heading' }}">{{ p }}</a>
                                </li>
                            {% elseif (p - query.page)|abs == 3 %}
                                <li class="grid h-8 min-w-8 place-items-center text-body-subtle">…</li>
                            {% endif %}
                        {% endfor %}
                    </ul>
                </nav>
            {% endif %}
        {% endblock %}
    </div>
{% endblock %}
