{#
    Shared confirmation dialog (Flowbite modal), driven by assets/admin/confirm.js.
    Any form / submit button with data-confirm="message" opens it; optional:
    data-confirm-title, data-confirm-button (label), data-confirm-variant="primary" (default: danger).
#}
<div id="confirm-modal" tabindex="-1" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="confirm-modal-title"
     class="hidden fixed inset-0 z-50 justify-center items-center w-full h-full overflow-y-auto overflow-x-hidden p-4">
    <div class="relative w-full max-w-md">
        <div class="relative bg-neutral-primary-soft border border-default rounded-base shadow-xl p-6 sm:p-8 text-center">
            <button type="button" data-confirm-cancel aria-label="Закрыть"
                    class="absolute top-3 end-3 inline-flex items-center justify-center w-9 h-9 rounded-base text-body hover:bg-neutral-tertiary hover:text-heading cursor-pointer">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
            </button>

            <div data-confirm-icon="danger" class="mx-auto mb-5 flex h-14 w-14 items-center justify-center rounded-full bg-danger-soft text-fg-danger">
                <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0"/></svg>
            </div>
            <div data-confirm-icon="primary" class="hidden mx-auto mb-5 h-14 w-14 items-center justify-center rounded-full bg-brand-softer text-fg-brand">
                <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </div>

            <h3 id="confirm-modal-title" data-confirm-title class="mb-2 text-xl font-semibold text-heading">Удалить?</h3>
            <p data-confirm-message class="mb-7 text-body"></p>

            <div class="flex flex-col-reverse gap-3 sm:flex-row sm:justify-center">
                <button type="button" data-confirm-cancel class="btn btn-secondary sm:min-w-32">Отмена</button>
                <button type="button" data-confirm-accept class="btn btn-danger sm:min-w-32">Да, удалить</button>
            </div>
        </div>
    </div>
</div>
