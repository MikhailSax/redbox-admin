{% extends 'admin/layout.html.twig' %}

{% set heading = service.id ? service.name : 'Новая услуга' %}

{% block title %}{{ heading }} — {{ parent() }}{% endblock %}

{% block content %}
    <nav class="mb-2 text-sm">
        <a href="{{ path('admin_service_index') }}" class="text-body hover:text-heading">Услуги</a>
        <span class="mx-1 text-body-subtle">/</span>
        <span class="text-heading">{{ service.id ? '#' ~ service.id : 'Новая' }}</span>
    </nav>
    <h1 class="page-title mb-6">{{ heading }}</h1>

    {% form_theme form 'admin/form/theme.html.twig' %}
    {{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}
        <div class="card mb-6 max-w-3xl">
            {{ form_errors(form) }}
            <div class="grid gap-x-6 md:grid-cols-[1fr_10rem]">
                {{ form_row(form.name) }}
                {{ form_row(form.unit) }}
            </div>
            <div class="grid gap-x-6 md:grid-cols-2">
                {{ form_row(form.price) }}
                {{ form_row(form.costPrice) }}
            </div>
            {{ form_row(form.description) }}
            {{ form_row(form.active, {row_attr: {class: 'mb-0'}}) }}
        </div>

        <div class="flex flex-wrap items-center gap-3">
            <button type="submit" class="btn btn-primary">{{ service.id ? 'Сохранить' : 'Создать' }}</button>
            <a href="{{ path('admin_service_index') }}" class="btn btn-secondary">К списку</a>
        </div>
    {{ form_end(form) }}
        {{ include('admin/_service_units.html.twig') }}
{% endblock %}
