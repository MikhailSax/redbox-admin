{# Symfony tailwind form theme using the admin design system classes (assets/styles/app.css) #}
{% use 'tailwind_2_layout.html.twig' %}

{%- block form_row -%}
    {%- set row_class = row_class|default('mb-5') -%}
    {{- parent() -}}
{%- endblock form_row -%}

{%- block widget_attributes -%}
    {%- set widget_class = widget_class|default('input') -%}
    {%- set widget_errors_class = widget_errors_class|default('!border-danger focus:!ring-danger/10') -%}
    {%- set widget_disabled_class = widget_disabled_class|default('cursor-not-allowed bg-zinc-50 text-body-subtle') -%}
    {{- parent() -}}
{%- endblock widget_attributes -%}

{%- block form_label -%}
    {%- set label_class = label_class|default('mb-1.5 block text-sm font-medium text-heading') -%}
    {{- parent() -}}
{%- endblock form_label -%}

{%- block form_label_content -%}
    {{- parent() -}}
    {%- if required and label is not same as(false) -%}<span class="ms-0.5 text-accent">*</span>{%- endif -%}
{%- endblock form_label_content -%}

{%- block form_help -%}
    {%- set help_class = help_class|default('mt-1.5 text-xs text-body-subtle') -%}
    {{- parent() -}}
{%- endblock form_help -%}

{%- block form_errors -%}
    {%- set error_item_class = error_item_class|default('mt-1.5 text-sm text-fg-danger-strong') -%}
    {{- parent() -}}
{%- endblock form_errors -%}

{%- block checkbox_widget -%}
    {%- set widget_class = widget_class|default('checkbox me-2') -%}
    {{- parent() -}}
{%- endblock checkbox_widget -%}

{%- block checkbox_row -%}
    {%- set label_class = label_class|default('select-none text-sm font-medium text-heading') -%}
    {{- parent() -}}
{%- endblock checkbox_row -%}

{%- block choice_widget_expanded -%}
    <div {{ block('widget_container_attributes') }} class="grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
        {%- for child in form %}
            <label class="flex cursor-pointer items-center gap-2.5 rounded-lg border border-default bg-white px-3 py-2.5 shadow-xs transition-colors hover:bg-zinc-50 has-checked:border-zinc-900 has-checked:bg-zinc-50 has-checked:ring-1 has-checked:ring-zinc-900">
                {{- form_widget(child, {widget_class: 'checkbox ' ~ ('radio' in child.vars.block_prefixes ? '!rounded-full' : '')}) -}}
                <span class="text-sm text-heading">{{ child.vars.label }}</span>
            </label>
        {% else %}
            <p class="text-sm text-body">Список пуст.</p>
        {% endfor -%}
    </div>
{%- endblock choice_widget_expanded -%}

{%- block money_widget -%}
    <div class="relative">
        {{- block('form_widget_simple') -}}
        <span class="pointer-events-none absolute inset-y-0 end-0 flex items-center pe-3 text-sm text-body-subtle">
            {{- money_pattern|replace({'{{ widget }}': ''})|trim -}}
        </span>
    </div>
{%- endblock money_widget -%}
