{% extends 'admin/layout.html.twig' %}

{% block title %}Типы — {{ parent() }}{% endblock %}

{% block content %}
    <div class="page-header">
        <div>
            <h1 class="page-title">Типы конструкций</h1>
            <p class="text-sm text-body">Статика, призматрон, видеоэкран…</p>
        </div>
        <a href="{{ path('admin_product_type_new') }}" class="btn btn-primary">+ Добавить тип</a>
    </div>

    <div class="table-card">
        <table class="data-table">
            <thead>
                <tr>
                    <th scope="col" class="px-4 py-3 font-medium">Название</th>
                    <th scope="col" class="px-4 py-3 font-medium">Категории</th>
                    <th scope="col" class="px-4 py-3 font-medium text-right">Конструкций</th>
                    <th scope="col" class="px-4 py-3 font-medium">Обновлено</th>
                    <th scope="col" class="px-4 py-3 font-medium"><span class="sr-only">Действия</span></th>
                </tr>
            </thead>
            <tbody>
                {% for type in types %}
                    {% set used = productCounts[type.id] ?? 0 %}
                    <tr>
                        <th scope="row" class="px-4 py-3 font-medium text-heading">
                            <a href="{{ path('admin_product_type_edit', {id: type.id}) }}" class="hover:underline">{{ type.name }}</a>
                            <div class="text-xs font-normal text-body mt-1">Бронь: {{ type.bookingMode.label }}</div>
                            {% if type.description %}
                                <div class="text-xs font-normal text-body mt-1">{{ type.description|length > 120 ? type.description|slice(0, 120) ~ '…' : type.description }}</div>
                            {% endif %}
                        </th>
                        <td class="px-4 py-3">
                            <div class="flex flex-wrap gap-1">
                                {% for category in type.categories %}
                                    <span class="bg-brand-softer border border-brand-subtle text-fg-brand-strong text-xs font-medium px-1.5 py-0.5 rounded-sm">{{ category.name }}</span>
                                {% else %}
                                    —
                                {% endfor %}
                            </div>
                        </td>
                        <td class="px-4 py-3 text-right">
                            {% if used %}
                                <a href="{{ path('admin_product_index', {type: type.id}) }}" class="font-medium text-fg-brand hover:underline">{{ used }}</a>
                            {% else %}0{% endif %}
                        </td>
                        <td class="px-4 py-3 whitespace-nowrap">{{ type.updatedAt|date('d.m.Y H:i') }}</td>
                        <td class="px-4 py-3">
                            <div class="flex justify-end gap-2">
                                <a href="{{ path('admin_product_type_edit', {id: type.id}) }}" class="btn btn-secondary btn-sm">Изменить</a>
                                {{ include('admin/_delete_form.html.twig', {
                                    action: path('admin_product_type_delete', {id: type.id}),
                                    token_id: 'delete-type-' ~ type.id,
                                    confirm: 'Удалить тип «' ~ type.name ~ '»?',
                                }) }}
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="5" class="px-4 py-10 text-center">
                            Типов пока нет. <a href="{{ path('admin_product_type_new') }}" class="font-medium text-fg-brand hover:underline">Добавить первый</a>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
