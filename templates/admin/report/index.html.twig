{% extends 'admin/layout.html.twig' %}
{% import 'admin/_icons.html.twig' as ui %}

{% macro rub(amount) %}{{ amount|money }}{% endmacro %}

{% block title %}Отчёты — {{ parent() }}{% endblock %}

{% block content %}
    <div class="page-header">
        <div>
            <h1 class="page-title">Отчёты</h1>
            <p class="page-subtitle">Продажи — что продано за период, отгрузки — на сколько загружены конструкции в эти месяцы, по дням размещения.</p>
        </div>
    </div>

    {# The period: a preset or months from — to; applied as you choose (assets/admin/live-filter.js) #}
    <form method="get" action="{{ path('admin_report_index') }}" data-live-filter="report-results" class="mb-5 flex flex-wrap items-center gap-2">
        <input type="hidden" name="view" value="{{ view == 'shipments' ? 'shipments' }}">
        <select name="from" class="filter" aria-label="С месяца">
            {% for m in months %}
                <option value="{{ m|date('Y-m') }}" {{ m|date('Y-m') == from|date('Y-m') ? 'selected' }}>с {{ m|month_label|lower }}</option>
            {% endfor %}
        </select>
        <select name="to" class="filter" aria-label="По месяц">
            {% for m in months %}
                <option value="{{ m|date('Y-m') }}" {{ m|date('Y-m') == to|date('Y-m') ? 'selected' }}>по {{ m|month_label|lower }}</option>
            {% endfor %}
        </select>
        <select name="side" class="filter" aria-label="Сторона">
            <option value="">Все стороны</option>
            {% for side in constant('App\\Dto\\ProductListQuery::SIDES') %}
                <option value="{{ side }}" {{ query.side == side ? 'selected' }}>Сторона {{ side }}</option>
            {% endfor %}
        </select>
        <select name="manager" class="filter" aria-label="Менеджер">
            <option value="">Все менеджеры</option>
            {% for author in authors %}
                <option value="{{ author.id }}" {{ query.manager == author.id ? 'selected' }}>{{ author.name ?: author.email }}{{ author == app.user ? ' (я)' }}</option>
            {% endfor %}
        </select>
        {% for name in ['sort', 'dir', 'msort', 'mdir'] %}
            <input type="hidden" name="{{ name }}" value="{{ attribute(query, name) }}">
        {% endfor %}
        <noscript><button type="submit" class="btn btn-primary">Показать</button></noscript>
    </form>

    <div id="report-results">
        {% block results %}
            {% import _self as fmt %}
            {% import 'admin/report/_sort.html.twig' as sorting %}
            {% import 'admin/_icons.html.twig' as ui %}
            {# Which report: sales by the month of confirmation, or shipments by the days of placement #}
            {% set view_param = view == 'shipments' ? 'shipments' : null %}
            {# what every link of the report carries along: the period, the report, the filters and the sorting #}
            {% set keep = {from: from|date('Y-m'), to: to|date('Y-m'), view: view_param, side: query.side, manager: query.manager, sort: query.sort, dir: query.dir, msort: query.msort, mdir: query.mdir}|filter(v => v is not null and v != '') %}
            <nav class="mb-4 flex gap-1 border-b border-default text-sm font-medium" aria-label="Отчёт">
                {% for key, label in {sales: 'Продажи', shipments: 'Отгрузки'} %}
                    <a href="{{ path('admin_report_index', keep|merge({view: key == 'shipments' ? 'shipments' : null})|filter(v => v is not null)) }}" data-live-link data-report-view="{{ key }}"
                       class="-mb-px border-b-2 px-4 py-2.5 {{ view == key ? 'border-brand text-fg-brand' : 'border-transparent text-body hover:text-heading' }}"{% if view == key %} aria-current="page"{% endif %}>{{ label }}</a>
                {% endfor %}
            </nav>
            <div class="mb-6 flex flex-wrap gap-2">
                {% for label, range in presets %}
                    {% set on = range[0]|date('Y-m') == from|date('Y-m') and range[1]|date('Y-m') == to|date('Y-m') %}
                    <a href="{{ path('admin_report_index', keep|merge({from: range[0]|date('Y-m'), to: range[1]|date('Y-m')})) }}" data-live-link class="chip {{ on ? 'chip-on' }}">{{ label }}</a>
                {% endfor %}
                {% if query.side or query.manager %}
                    <a href="{{ path('admin_report_index', keep|filter((v, k) => k not in ['side', 'manager'])) }}" data-live-link class="ms-auto self-center text-sm font-medium text-body hover:text-heading hover:underline">Сбросить сторону и менеджера</a>
                {% endif %}
            </div>

            {% if view == 'shipments' %}
                {{ include('admin/report/_shipments.html.twig') }}
            {% else %}
            <p class="mb-4 text-sm text-body">Продажа — бронь, подтверждённая или оплаченная за период и не отменённая. Сумма — «Продано за» и услуги, целиком в месяц подтверждения.</p>

            {# Totals of the period #}
            <dl class="mb-8 grid gap-3 sm:grid-cols-2 xl:grid-cols-5">
                {% for tile in [
                    {label: 'Продаж', value: totals.sales, hint: totals.unpriced ? 'без суммы: ' ~ totals.unpriced : null},
                    {label: 'Загружено на', value: fmt.rub(totals.total), hint: 'размещение ' ~ totals.placement|money ~ ' · услуги ' ~ totals.services|money},
                    {label: 'Оплачено', value: fmt.rub(totals.paid), hint: totals.total > 0 ? (totals.paid * 100 / totals.total)|round ~ '% от проданного' : null},
                    {label: 'Средний чек', value: fmt.rub(totals.average), hint: null},
                    {label: 'Загружено поверхностей', value: (totals.allSides ? (totals.sides * 100 / totals.allSides)|round : 0) ~ '%', hint: totals.sides ~ ' из ' ~ totals.allSides ~ ' сторон' ~ (query.side ? ' ' ~ query.side : '') ~ ' · конструкций ' ~ totals.products ~ ' из ' ~ totals.allProducts},
                ] %}
                    <div class="rounded-md bg-zinc-100 px-4 py-3" data-total="{{ loop.index }}">
                        <dt class="text-xs font-semibold text-body-subtle">{{ tile.label }}</dt>
                        <dd class="mt-1 text-xl font-semibold tabular-nums text-heading">{{ tile.value }}</dd>
                        {% if tile.hint %}<dd class="mt-0.5 text-xs text-body">{{ tile.hint }}</dd>{% endif %}
                    </div>
                {% endfor %}
            </dl>
            {{ include('admin/report/_kinds.html.twig') }}

            {# By structure #}
            <h2 class="mb-2 text-lg font-semibold text-heading">По конструкциям</h2>
            <div class="table-card mb-3">
                <table class="data-table" id="report-products">
                    <thead>
                        <tr>
                            {{ sorting.th('Конструкция', 'name', keep, align: 'left') }}
                            <th scope="col" class="px-3">Стороны</th>
                            {{ sorting.th('Продаж', 'sales', keep) }}
                            {{ sorting.th('Срок', 'term', keep, title: 'Статика — месяцев сторон, экраны — дней эфира') }}
                            {{ sorting.th('Размещение', 'placement', keep) }}
                            {{ sorting.th('Услуги', 'services', keep) }}
                            {{ sorting.th('Итого', 'total', keep) }}
                            <th scope="col" class="px-3">Доля</th>
                            {{ sorting.th('Оплачено', 'paid', keep) }}
                        </tr>
                    </thead>
                    <tbody>
                        {% for row in products %}
                            <tr>
                                <th scope="row" class="px-3 font-normal">
                                    <a href="{{ path('admin_booking_product', {id: row.product.id}) }}" class="font-medium text-heading hover:underline">{{ row.product.name }}</a>
                                    <div class="text-xs text-body-subtle">{{ row.product.typeLabel }}{% if row.product.district %} · {{ row.product.district.name }}{% endif %}</div>
                                </th>
                                <td class="px-3">
                                    <div class="flex gap-1">
                                        {% for side in row.sides %}<span class="inline-flex h-5 min-w-5 items-center justify-center rounded-sm bg-zinc-100 px-1 text-xs font-semibold text-heading">{{ side }}</span>{% endfor %}
                                    </div>
                                </td>
                                <td class="px-3 text-right tabular-nums">{{ row.sales }}</td>
                                <td class="px-3 text-right tabular-nums whitespace-nowrap">
                                    {%- if row.months %}{{ row.months }} мес.{% endif -%}
                                    {%- if row.months and row.airtimeDays %}<br>{% endif -%}
                                    {%- if row.airtimeDays %}{{ row.airtimeDays }} дн. эфира{% endif -%}
                                </td>
                                <td class="px-3 text-right tabular-nums whitespace-nowrap">
                                    {{ fmt.rub(row.placement) }}
                                    {% if row.unpriced %}<div class="text-xs text-fg-warning">без суммы: {{ row.unpriced }}</div>{% endif %}
                                </td>
                                <td class="px-3 text-right tabular-nums whitespace-nowrap">{{ row.services ? fmt.rub(row.services) : '—' }}</td>
                                <td class="px-3 text-right font-semibold tabular-nums text-heading whitespace-nowrap">{{ fmt.rub(row.total) }}</td>
                                <td class="px-3">
                                    <div class="flex items-center gap-2" title="Доля в проданном за период">
                                        <div class="h-1.5 w-20 overflow-hidden rounded-full bg-zinc-200"><div class="h-full bg-zinc-800" style="width: {{ row.share|round(1) }}%"></div></div>
                                        <span class="text-xs tabular-nums text-body">{{ row.share|round }}%</span>
                                    </div>
                                </td>
                                <td class="px-3 text-right tabular-nums whitespace-nowrap {{ row.paid < row.total ? 'text-fg-warning' : 'text-fg-success-strong' }}">{{ fmt.rub(row.paid) }}</td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="9" class="px-4 py-12 text-center">
                                    <span class="mx-auto mb-3 grid size-12 place-items-center rounded-full bg-zinc-100 text-zinc-400">{{ ui.icon('chart') }}</span>
                                    <p class="font-medium text-heading">За этот период продаж нет</p>
                                    <p class="mt-1 text-sm text-body">Продажа появляется здесь, когда бронь подтверждают или отмечают оплату.</p>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            {% if idle is not empty %}
                <details class="mb-8 text-sm">
                    <summary class="cursor-pointer font-medium text-body hover:text-heading">Не продавались за период: {{ idle|length|plural('конструкция', 'конструкции', 'конструкций') }}</summary>
                    <ul class="mt-2 columns-1 gap-6 sm:columns-2 xl:columns-3">
                        {% for product in idle %}
                            <li class="py-0.5"><a href="{{ path('admin_booking_product', {id: product.id}) }}" class="text-heading hover:underline">{{ product.name }}</a></li>
                        {% endfor %}
                    </ul>
                </details>
            {% else %}
                <div class="mb-8"></div>
            {% endif %}

            {# By who made the booking #}
            <h2 class="mb-2 text-lg font-semibold text-heading">По менеджерам</h2>
            <div class="table-card">
                <table class="data-table" id="report-managers">
                    <thead>
                        <tr>
                            {{ sorting.th('Оформил', 'name', keep, 'msort', 'mdir', 'left') }}
                            {{ sorting.th('Продаж', 'sales', keep, 'msort', 'mdir') }}
                            {{ sorting.th('Загружено на', 'total', keep, 'msort', 'mdir') }}
                            {{ sorting.th('Оплачено', 'paid', keep, 'msort', 'mdir') }}
                            {{ sorting.th('Средний чек', 'average', keep, 'msort', 'mdir') }}
                            {{ sorting.th('Сгорело броней', 'burned', keep, 'msort', 'mdir', title: 'Брони, которые сгорели за период: их не подтвердили за 24 часа') }}
                        </tr>
                    </thead>
                    <tbody>
                        {% for row in managers %}
                            <tr>
                                <th scope="row" class="px-3 font-normal">
                                    <span class="flex items-center gap-2">
                                        {% if row.user %}
                                            <span class="avatar">{{ row.user.name|initials }}</span>
                                            <span class="font-medium text-heading">{{ row.user.name ?: row.user.email }}</span>
                                        {% else %}
                                            <span class="avatar">—</span>
                                            <span class="text-body" title="Импортированные брони и брони, оформленные без менеджера">Без менеджера</span>
                                        {% endif %}
                                    </span>
                                </th>
                                <td class="px-3 text-right tabular-nums">{{ row.sales }}</td>
                                <td class="px-3 text-right font-semibold tabular-nums text-heading whitespace-nowrap">{{ fmt.rub(row.total) }}</td>
                                <td class="px-3 text-right tabular-nums whitespace-nowrap">{{ fmt.rub(row.paid) }}</td>
                                <td class="px-3 text-right tabular-nums whitespace-nowrap">{{ row.sales ? fmt.rub(row.average) : '—' }}</td>
                                <td class="px-3 text-right tabular-nums {{ row.burned ? 'text-fg-danger-strong' : 'text-body-subtle' }}">{{ row.burned }}</td>
                            </tr>
                        {% else %}
                            <tr><td colspan="6" class="px-4 py-8 text-center text-body">За этот период продаж нет.</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            {% endif %}
        {% endblock %}
    </div>
{% endblock %}
