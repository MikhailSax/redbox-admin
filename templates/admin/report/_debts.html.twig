{#
    Receivables as of today (DebtReport): what every client still owes, how much of it is late and how late.
    Variables: totals, clients, overdue, now, query.
#}
{% import 'admin/_icons.html.twig' as ui %}
{% set buckets = constant('App\\Service\\DebtReport::BUCKET_LABELS') %}
<p class="mb-4 text-sm text-body">Долг — все неоплаченные платежи календаря на {{ now|date('d.m.Y') }}, период не важен. Просрочка — платежи, у которых прошёл срок; разбита по числу дней просрочки.</p>

<dl class="mb-6 grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
    {% for tile in [
        {key: 'debt', label: 'Должны всего', value: totals.debt|money, hint: totals.clients|plural('клиент', 'клиента', 'клиентов') ~ ' · ' ~ totals.payments|plural('платёж', 'платежа', 'платежей')},
        {key: 'overdue', label: 'Просрочено', value: totals.overdue|money, hint: totals.overdueClients ? totals.overdueClients|plural('клиент', 'клиента', 'клиентов') : 'просрочки нет', danger: totals.overdue > 0},
        {key: 'current', label: 'Срок не наступил', value: totals.current|money, hint: 'ожидается по графикам'},
        {key: 'share', label: 'Доля просрочки', value: (totals.debt > 0 ? (totals.overdue * 100 / totals.debt)|round : 0) ~ '%', hint: 'от всего долга'},
    ] %}
        <div class="rounded-md bg-zinc-100 px-4 py-3" data-debt-total="{{ tile.key }}">
            <dt class="text-xs font-semibold text-body-subtle">{{ tile.label }}</dt>
            <dd class="mt-1 text-xl font-semibold tabular-nums {{ tile.danger ?? false ? 'text-fg-danger' : 'text-heading' }}">{{ tile.value }}</dd>
            <dd class="mt-0.5 text-xs text-body">{{ tile.hint }}</dd>
        </div>
    {% endfor %}
</dl>

{# Aging: how the overdue money splits by days late #}
{% if totals.overdue > 0 %}
    <div class="mb-8">
        <div class="mb-2 flex h-2.5 overflow-hidden rounded-full bg-zinc-200" role="img" aria-label="Просрочка по срокам">
            {% for key, label in buckets %}
                {% if totals[key] > 0 %}
                    <div class="h-full {{ {d30: 'bg-warning', d60: 'bg-orange-500', d90: 'bg-danger', older: 'bg-red-900'}[key] }}" style="width: {{ (totals[key] * 100 / totals.overdue)|round(1) }}%" title="{{ label }}: {{ totals[key]|money }}"></div>
                {% endif %}
            {% endfor %}
        </div>
        <dl class="flex flex-wrap gap-x-6 gap-y-1 text-sm">
            {% for key, label in buckets %}
                <div class="flex items-center gap-2" data-debt-bucket="{{ key }}">
                    <span class="size-2.5 rounded-sm {{ {d30: 'bg-warning', d60: 'bg-orange-500', d90: 'bg-danger', older: 'bg-red-900'}[key] }}"></span>
                    <dt class="text-body">{{ label }}</dt>
                    <dd class="font-medium tabular-nums text-heading">{{ totals[key]|money }}</dd>
                </div>
            {% endfor %}
        </dl>
    </div>
{% endif %}

<h2 class="mb-2 text-lg font-semibold text-heading">По клиентам</h2>
<div class="table-card mb-8">
    <table class="data-table" id="debt-clients">
        <thead>
            <tr>
                <th scope="col" class="px-3">Клиент</th>
                <th scope="col" class="px-3 text-right">Долг</th>
                <th scope="col" class="px-3 text-right">Срок не наступил</th>
                <th scope="col" class="px-3 text-right">Просрочено</th>
                {% for label in buckets %}<th scope="col" class="px-3 text-right whitespace-nowrap">{{ label }}</th>{% endfor %}
                <th scope="col" class="px-3 text-right" title="Самый старый просроченный платёж">Макс. просрочка</th>
            </tr>
        </thead>
        <tbody>
            {% for row in clients %}
                <tr data-debt-client="{{ row.client.id }}">
                    <th scope="row" class="px-3 font-normal">
                        <a href="{{ path('admin_client_show', {id: row.client.id, _fragment: 'payments'}) }}" class="font-medium text-heading hover:underline">{{ row.client.clientTitle }}</a>
                        <div class="text-xs text-body-subtle">
                            {{ row.payments|plural('платёж', 'платежа', 'платежей') }}
                            {%- if row.nextDue %} · следующий до {{ row.nextDue|date('d.m.Y') }}{% endif %}
                        </div>
                    </th>
                    <td class="px-3 text-right font-semibold tabular-nums text-heading whitespace-nowrap">{{ row.debt|money }}</td>
                    <td class="px-3 text-right tabular-nums whitespace-nowrap">{{ row.current ? row.current|money : '—' }}</td>
                    <td class="px-3 text-right tabular-nums whitespace-nowrap {{ row.overdue > 0 ? 'font-semibold text-fg-danger' }}">{{ row.overdue ? row.overdue|money : '—' }}</td>
                    {% for key, label in buckets %}
                        <td class="px-3 text-right tabular-nums whitespace-nowrap">{{ row[key] ? row[key]|money : '—' }}</td>
                    {% endfor %}
                    <td class="px-3 text-right tabular-nums whitespace-nowrap">{{ row.maxDays ? row.maxDays|plural('день', 'дня', 'дней') : '—' }}</td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="9" class="px-4 py-12 text-center">
                        <span class="mx-auto mb-3 grid size-12 place-items-center rounded-full bg-zinc-100 text-zinc-400">{{ ui.icon('check') }}</span>
                        <p class="font-medium text-heading">Никто ничего не должен</p>
                        <p class="mt-1 text-sm text-body">Все платежи календаря оплачены.</p>
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>

{% if overdue is not empty %}
    <h2 class="mb-2 text-lg font-semibold text-heading">Просроченные платежи</h2>
    <div class="table-card">
        <table class="data-table" id="debt-overdue">
            <thead>
                <tr>
                    <th scope="col" class="px-3">Клиент</th>
                    <th scope="col" class="px-3">За что</th>
                    <th scope="col" class="px-3 text-right">Сумма</th>
                    <th scope="col" class="px-3 text-right">Срок</th>
                    <th scope="col" class="px-3 text-right">Просрочка</th>
                </tr>
            </thead>
            <tbody>
                {% for row in overdue %}
                    <tr>
                        <td class="px-3"><a href="{{ path('admin_client_show', {id: row.payment.client.id, _fragment: 'payments'}) }}" class="font-medium text-heading hover:underline">{{ row.payment.client.clientTitle }}</a></td>
                        <td class="px-3"><a href="{{ path('admin_payment_edit', {id: row.payment.id}) }}" class="text-heading hover:underline">{{ row.payment.title }}</a></td>
                        <td class="px-3 text-right tabular-nums whitespace-nowrap">{{ row.payment.amount|money }}</td>
                        <td class="px-3 text-right tabular-nums">{{ row.payment.dueDate|date('d.m.Y') }}</td>
                        <td class="px-3 text-right tabular-nums text-fg-danger whitespace-nowrap">{{ row.days|plural('день', 'дня', 'дней') }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endif %}
