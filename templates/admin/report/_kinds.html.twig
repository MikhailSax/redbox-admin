{# placed not for money: how many of each kind, the certificates' sums apart #}
{% if totals.kinds is not empty %}
    <p class="-mt-5 mb-8 flex flex-wrap gap-x-4 gap-y-1 text-sm text-body" data-report-kinds>
        <span class="font-medium text-heading">Не за деньги:</span>
        {% for kind in enum_cases('App\\Enum\\BookingKind')|filter(k => not k.sold and totals.kinds[k.value] is defined) %}
            <span>{{ kind.label }} — {{ totals.kinds[kind.value] }}{% if kind.value == 'certificate' %} на {{ totals.certificates|money }}{% endif %}</span>
        {% endfor %}
    </p>
{% endif %}
