{% extends 'admin/layout.html.twig' %}
{% import 'admin/_icons.html.twig' as ui %}

{% block title %}Клиенты — {{ parent() }}{% endblock %}

{% block content %}
    <div class="page-header">
        <div>
            <h1 class="page-title">Клиенты</h1>
            <p class="page-subtitle">Учётные записи личного кабинета на сайте: договоры, счета и фотоотчёты клиента</p>
        </div>
        <a href="{{ path('admin_client_new') }}" class="btn btn-primary">{{ ui.icon('plus', 'size-4') }} Новый клиент</a>
    </div>

    <form method="get" action="{{ path('admin_client_index') }}" data-live-filter="client-results" class="mb-4 flex flex-wrap items-center gap-3">
        <label class="search-field max-w-md flex-1">
            <span class="sr-only">Поиск</span>
            {{ ui.icon('search') }}
            <input type="search" name="q" value="{{ q }}" class="input" autocomplete="off" placeholder="Организация, ИНН, имя, email или телефон…">
        </label>
        {% if type %}<input type="hidden" name="type" value="{{ type.value }}">{% endif %}
        <div class="flex flex-wrap gap-2">
            {% set chip = 'inline-flex h-8 items-center gap-1.5 rounded-full border px-3 text-sm font-medium transition-colors' %}
            {% for option in [{value: null, label: 'Все', count: typeCounts|reduce((s, n) => s + n, 0)}]|merge(enum_cases('App\\Enum\\ClientType')|map(t => {value: t, label: t.label, count: typeCounts[t.value]})) %}
                <a href="{{ path('admin_client_index', {q: q ?: null, type: option.value ? option.value.value : null}|filter(v => v is not null)) }}"
                   class="{{ chip }} {{ option.value == type ? 'border-zinc-900 bg-zinc-900 text-white' : 'border-default bg-white text-body hover:text-heading' }}">{{ option.label }} <span class="tabular-nums opacity-60">{{ option.count }}</span></a>
            {% endfor %}
        </div>
    </form>

    <div id="client-results">
        {% block results %}
            {# Imported here too: renderBlock() (live filter) renders this block without the template top level #}
            {% import 'admin/_icons.html.twig' as ui %}
            <div class="table-card">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th scope="col" class="px-4 py-2.5">Клиент</th>
                            <th scope="col" class="px-4 py-2.5">Контакты</th>
                            <th scope="col" class="px-4 py-2.5 text-right">Просрочено</th>
                            <th scope="col" class="px-4 py-2.5 text-right">Документы</th>
                            <th scope="col" class="px-4 py-2.5 text-right">Фотоотчёты</th>
                            <th scope="col" class="px-4 py-2.5">Добавлен</th>
                            <th scope="col" class="px-4 py-2.5"><span class="sr-only">Действия</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for client in clients %}
                            <tr>
                                <th scope="row" class="px-4 py-3 font-normal">
                                    <a href="{{ path('admin_client_show', {id: client.id}) }}" class="group flex items-center gap-3">
                                        <span class="grid size-9 shrink-0 place-items-center rounded-full bg-zinc-100 text-xs font-semibold text-heading">{{ (client.company ?? client.name)|initials }}</span>
                                        <span class="min-w-0">
                                            <span class="block truncate font-medium text-heading group-hover:underline">{{ (client.company ?? client.name)|highlight(q) }}</span>
                                            <span class="block truncate text-xs text-body-subtle">
                                                {{- client.clientType ? client.clientType.label : 'Клиент' -}}
                                                {%- if client.inn %} · ИНН {{ client.inn|highlight(q) }}{% endif -%}
                                                {%- if client.company %} · {{ client.name|highlight(q) }}{% endif -%}
                                            </span>
                                        </span>
                                    </a>
                                </th>
                                <td class="px-4 py-3">
                                    <div class="text-heading">{{ client.email|highlight(q) }}</div>
                                    {% if not client.emailVerified %}<span class="mt-1 inline-flex rounded-md bg-warning-soft px-1.5 py-0.5 text-xs font-medium text-fg-warning ring-1 ring-warning-subtle" title="Зарегистрировался на сайте и не подтвердил почту">почта не подтверждена</span>{% endif %}
                                    {% if client.phone %}<div class="text-xs text-body-subtle">{{ client.phone|highlight(q) }}</div>{% endif %}
                                </td>
                                <td class="px-4 py-3 text-right tabular-nums whitespace-nowrap">
                                    {% if overdueSums[client.id] is defined %}
                                        <a href="{{ path('admin_client_show', {id: client.id, _fragment: 'payments'}) }}" class="font-semibold text-fg-danger-strong hover:underline">{{ overdueSums[client.id]|money }}</a>
                                    {% else %}<span class="text-body-subtle">—</span>{% endif %}
                                </td>
                                <td class="px-4 py-3 text-right tabular-nums">{{ documentCounts[client.id] ?? 0 }}</td>
                                <td class="px-4 py-3 text-right tabular-nums">{{ reportCounts[client.id] ?? 0 }}</td>
                                <td class="px-4 py-3 whitespace-nowrap">{{ client.createdAt|date('d.m.Y') }}</td>
                                <td class="px-4 py-3">
                                    <div class="flex justify-end gap-1">
                                        <a href="{{ path('admin_client_show', {id: client.id}) }}" class="btn btn-secondary btn-sm">Открыть</a>
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="7" class="px-4 py-16 text-center">
                                    <span class="mx-auto mb-3 grid size-12 place-items-center rounded-full bg-zinc-100 text-zinc-400">{{ ui.icon('client') }}</span>
                                    {% if q or type %}
                                        <p class="font-medium text-heading">Ничего не найдено{{ q ? ' по запросу «' ~ q ~ '»' }}</p>
                                    {% else %}
                                        <p class="font-medium text-heading">Клиентов пока нет</p>
                                        <p class="mt-1 text-sm text-body">Клиенты появятся, когда зарегистрируются на сайте, или <a href="{{ path('admin_client_new') }}" class="font-medium text-heading underline">добавьте клиента</a> сами.</p>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endblock %}
    </div>
{% endblock %}
