{% extends 'admin/layout.html.twig' %}
{% import 'admin/_icons.html.twig' as ui %}

{% block title %}Обзор — {{ parent() }}{% endblock %}

{% block content %}
    <div class="page-header">
        <div>
            <p class="text-sm font-medium text-body-subtle">{{ now|date('d.m.Y') }}</p>
            {% set hour = now|date('G') %}
            <h1 class="page-title">{{ hour < 5 ? 'Доброй ночи' : (hour < 12 ? 'Доброе утро' : (hour < 18 ? 'Добрый день' : 'Добрый вечер')) }}{{ app.user ? ', ' ~ app.user.name|split(' ')|first : '' }}</h1>
            <p class="page-subtitle">Что происходит с конструкциями в {{ month|month_label|lower }}</p>
        </div>
        <div class="flex flex-wrap gap-2">
            <a href="{{ path('admin_booking_index', {status: 'hold'}) }}" class="btn btn-secondary">Брони на подтверждение</a>
            <a href="{{ path('admin_product_index', {status: 'free'}) }}" class="btn btn-primary">Свободные конструкции {{ ui.icon('arrow_right', 'size-4') }}</a>
        </div>
    </div>

    {# Load of the coming months, apart: billboards by sides, video screens by seconds of airtime #}
    {% set bb = billboards|first %}
    {% set sc = screens|first %}
    <div class="mb-6 grid gap-6 xl:grid-cols-2">
        <div class="card min-w-0" id="dashboard-billboards">
            <div class="mb-5 flex flex-wrap items-start justify-between gap-3">
                <div>
                    <h2 class="text-base font-semibold text-heading">Билборды</h2>
                    <p class="text-sm text-body">{{ bb.sides|plural('сторона', 'стороны', 'сторон') }} · продано на ближайшие {{ billboards|length }} мес.</p>
                </div>
                {{ _self.legend() }}
            </div>
            {% set stats = [
                {label: 'Свободны', value: bb.free, dot: 'bg-success'},
                {label: 'Забронированы', value: bb.booked, dot: 'bg-warning'},
                {label: 'Заняты', value: bb.occupied, dot: 'bg-danger'},
            ] %}
            <div class="mb-6 grid grid-cols-3 gap-3">
                {% for stat in stats %}
                    <div class="min-w-0 rounded-lg border border-default p-3">
                        <div class="flex items-center gap-1.5 truncate text-xs font-medium text-body"><span class="size-2 shrink-0 rounded-full {{ stat.dot }}"></span>{{ stat.label }}</div>
                        <div class="mt-1 flex items-baseline gap-1.5">
                            <span class="text-2xl font-semibold tracking-tight text-heading tabular-nums">{{ stat.value }}</span>
                            {% if bb.sides > 0 %}<span class="text-xs font-medium text-body-subtle">{{ (stat.value / bb.sides * 100)|round }}%</span>{% endif %}
                        </div>
                    </div>
                {% endfor %}
            </div>
            <div class="flex h-48 items-end gap-2 sm:gap-4">
                {% for row in billboards %}
                    {% set sold = row.sides > 0 ? ((row.occupied + row.booked) / row.sides * 100)|round : 0 %}
                    {{ _self.bar(row.month, sold, row.sides > 0 ? row.occupied / row.sides * 100 : 0, row.sides > 0 ? row.booked / row.sides * 100 : 0,
                        row.month|month_label ~ ': занято ' ~ row.occupied ~ ', бронь ' ~ row.booked ~ ', свободно ' ~ row.free ~ ' из ' ~ row.sides ~ ' сторон', loop.first) }}
                {% endfor %}
            </div>
        </div>

        <div class="card min-w-0" id="dashboard-screens">
            <div class="mb-5 flex flex-wrap items-start justify-between gap-3">
                <div>
                    <h2 class="text-base font-semibold text-heading">Видеоэкраны</h2>
                    <p class="text-sm text-body">{{ sc.screens|plural('экран', 'экрана', 'экранов') }} · доля проданного эфира в самый загруженный день</p>
                </div>
                {{ _self.legend() }}
            </div>
            {% set stats = [
                {label: 'Загрузка', value: sc.percent, dot: 'bg-zinc-500'},
                {label: 'Занято', value: sc.seconds > 0 ? (sc.occupied / sc.seconds * 100)|round : 0, dot: 'bg-danger'},
                {label: 'Бронь', value: sc.seconds > 0 ? (sc.booked / sc.seconds * 100)|round : 0, dot: 'bg-warning'},
            ] %}
            <div class="mb-6 grid grid-cols-3 gap-3">
                {% for stat in stats %}
                    <div class="min-w-0 rounded-lg border border-default p-3">
                        <div class="flex items-center gap-1.5 truncate text-xs font-medium text-body"><span class="size-2 shrink-0 rounded-full {{ stat.dot }}"></span>{{ stat.label }}</div>
                        <div class="mt-1 text-2xl font-semibold tracking-tight text-heading tabular-nums">{{ stat.value }}%</div>
                    </div>
                {% endfor %}
            </div>
            <div class="flex h-48 items-end gap-2 sm:gap-4">
                {% for row in screens %}
                    {{ _self.bar(row.month, row.percent, row.seconds > 0 ? row.occupied / row.seconds * 100 : 0, row.seconds > 0 ? row.booked / row.seconds * 100 : 0,
                        row.month|month_label ~ ': занято ' ~ row.occupied ~ ' сек, бронь ' ~ row.booked ~ ' сек из ' ~ row.seconds ~ ' сек эфира', loop.first) }}
                {% endfor %}
            </div>
        </div>
    </div>

    <div class="grid gap-6 xl:grid-cols-5">
        {# Each screen: how full its block is this month, the busiest first #}
        <div class="card min-w-0 !p-0 xl:col-span-3" id="dashboard-screen-load">
            <div class="px-5 pb-3 pt-5">
                <h2 class="text-base font-semibold text-heading">Загрузка экранов</h2>
                <p class="text-sm text-body">{{ month|month_label }}: занятые слоты в самый загруженный день</p>
            </div>
            <ul class="max-h-96 divide-y divide-default overflow-y-auto border-t border-default">
                {% for row in screenLoad %}
                    <li class="flex items-center gap-4 px-5 py-2.5">
                        <div class="min-w-0 flex-1">
                            <a href="{{ path('admin_booking_product', {id: row.productId}) }}" class="block truncate text-sm font-medium text-heading hover:underline">{{ row.product }}</a>
                            <p class="text-xs text-body">Сторона {{ row.side }} · {{ row.usedSlots }} из {{ row.slotCount }} слотов</p>
                        </div>
                        <div class="flex h-2 w-24 shrink-0 overflow-hidden rounded-full bg-zinc-100 sm:w-40" role="progressbar" aria-label="Загрузка экрана" aria-valuenow="{{ row.percent }}" aria-valuemin="0" aria-valuemax="100">
                            <div class="h-full bg-danger" style="width: {{ row.blockSeconds > 0 ? row.confirmedSeconds / row.blockSeconds * 100 : 0 }}%"></div>
                            <div class="h-full bg-warning" style="width: {{ row.blockSeconds > 0 ? row.holdSeconds / row.blockSeconds * 100 : 0 }}%"></div>
                        </div>
                        <span class="w-11 shrink-0 text-right text-sm font-semibold text-heading tabular-nums">{{ row.percent }}%</span>
                    </li>
                {% else %}
                    <li class="px-5 py-8 text-center text-sm text-body">Видеоэкранов нет</li>
                {% endfor %}
            </ul>
        </div>

        {# Holds waiting for confirmation: confirm / pay without a reload (assets/admin/ajax-forms.js) #}
        <div id="dashboard-holds" class="card min-w-0 !p-0 xl:col-span-2" data-ajax-forms data-ajax-region>
            <div class="flex items-center justify-between gap-3 px-5 pb-3 pt-5">
                <div>
                    <h2 class="text-base font-semibold text-heading">Ждут подтверждения</h2>
                    <p class="text-sm text-body">Снимутся автоматически через 24 часа</p>
                </div>
                {% if holdCount > 0 %}
                    <span class="rounded-md bg-warning-soft px-2 py-1 text-xs font-semibold text-fg-warning">{{ holdCount }}</span>
                {% endif %}
            </div>

            <ul class="divide-y divide-default">
                {% for booking in holds %}
                    {% set minutes_left = ((booking.expiresAt.timestamp - now.timestamp) / 60)|round(0, 'floor') %}
                    <li class="flex items-center gap-3 px-5 py-3">
                        <span class="grid size-9 shrink-0 place-items-center rounded-full text-xs font-semibold {{ minutes_left < 180 ? 'bg-danger-soft text-fg-danger-strong' : 'bg-warning-soft text-fg-warning' }}"
                              title="Осталось до снятия брони">
                            {{ minutes_left >= 60 ? (minutes_left / 60)|round(0, 'floor') ~ 'ч' : minutes_left ~ 'м' }}
                        </span>
                        <div class="min-w-0 flex-1">
                            <a href="{{ path('admin_booking_show', {id: booking.id}) }}" class="block truncate text-sm font-medium text-heading hover:underline">{{ booking.clientTitle }}</a>
                            <p class="truncate text-xs text-body">{{ booking.product.name }} · {{ booking.side.name }} · {{ period_label(booking.startDate, booking.endDate) }}</p>
                        </div>
                        {{ include('admin/booking/_actions.html.twig', {return: 'dashboard'}) }}
                    </li>
                {% else %}
                    <li class="px-5 pb-8 pt-4 text-center">
                        <span class="mx-auto mb-2 grid size-10 place-items-center rounded-full bg-success-soft text-fg-success-strong">{{ ui.icon('check') }}</span>
                        <p class="text-sm text-body">Неоплаченных броней нет</p>
                    </li>
                {% endfor %}
            </ul>
            {% if holdCount > holds|length %}
                <a href="{{ path('admin_booking_index', {status: 'hold'}) }}" class="block border-t border-default px-5 py-3 text-center text-sm font-medium text-heading hover:bg-zinc-50">Все {{ holdCount }} →</a>
            {% endif %}
        </div>
    </div>

    {# Client payments due: overdue first, then due soon #}
    <div class="card mt-6 !p-0" id="dashboard-payments">
        <div class="flex flex-wrap items-center justify-between gap-3 px-5 pb-3 pt-5">
            <div>
                <h2 class="text-base font-semibold text-heading">Платежи клиентов</h2>
                <p class="text-sm text-body">
                    {% if payments.overdue.count > 0 %}<span class="font-medium text-fg-danger-strong">Просрочено {{ payments.overdue.count }} на {{ payments.overdue.sum|money }}</span> · {% endif %}
                    скоро срок: {{ payments.soon.count }}{% if payments.soon.count > 0 %} на {{ payments.soon.sum|money }}{% endif %}
                </p>
            </div>
            <a href="{{ path('admin_payment_index') }}" class="btn btn-secondary btn-sm">{{ ui.icon('banknotes', 'size-4') }} Календарь платежей</a>
        </div>
        {% if payments.urgent is not empty %}
            <div class="border-t border-default">
                {{ include('admin/payment/_table.html.twig', {payments: payments.urgent, return: 'dashboard'}) }}
            </div>
        {% else %}
            <div class="px-5 pb-8 pt-2 text-center">
                <span class="mx-auto mb-2 grid size-10 place-items-center rounded-full bg-success-soft text-fg-success-strong">{{ ui.icon('check') }}</span>
                <p class="text-sm text-body">Просроченных и срочных платежей нет</p>
            </div>
        {% endif %}
    </div>
{% endblock %}

{% macro legend() %}
    <div class="flex flex-wrap gap-3 text-xs text-body">
        <span class="flex items-center gap-1.5"><span class="size-2 rounded-full bg-danger"></span>Занято</span>
        <span class="flex items-center gap-1.5"><span class="size-2 rounded-full bg-warning"></span>Бронь</span>
        <span class="flex items-center gap-1.5"><span class="size-2 rounded-full bg-zinc-200"></span>Свободно</span>
    </div>
{% endmacro %}

{# One month of the forecast: sold share on top, occupied and held parts stacked from the bottom #}
{% macro bar(month, sold, occupied_pct, booked_pct, title, current) %}
    <a href="{{ path('admin_product_index', {month: month|date('Y-m')}) }}" class="group flex h-full min-w-0 flex-1 flex-col items-center gap-2" title="{{ title }}">
        <span class="text-xs font-semibold text-heading tabular-nums">{{ sold }}%</span>
        <div class="relative flex w-full max-w-14 flex-1 flex-col-reverse overflow-hidden rounded-lg bg-zinc-100 transition group-hover:ring-2 group-hover:ring-zinc-300">
            <div class="w-full bg-danger" style="height: {{ occupied_pct }}%"></div>
            <div class="w-full bg-warning" style="height: {{ booked_pct }}%"></div>
        </div>
        <span class="truncate text-[11px] sm:text-xs {{ current ? 'font-semibold text-heading' : 'text-body' }}">{{ month|month_label(true) }}</span>
    </a>
{% endmacro %}
