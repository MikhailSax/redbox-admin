{% extends 'admin/layout.html.twig' %}

{% block title %}Категории — {{ parent() }}{% endblock %}

{% block content %}
    <div class="page-header">
        <div>
            <h1 class="page-title">Категории</h1>
            <p class="text-sm text-body">Форматы конструкций: билборд 6х3, сити-формат, суперсайт…</p>
        </div>
        <a href="{{ path('admin_category_new') }}" class="btn btn-primary">+ Добавить категорию</a>
    </div>

    <div class="table-card">
        <table class="data-table">
            <thead>
                <tr>
                    <th scope="col" class="px-4 py-3 font-medium">Изображение</th>
                    <th scope="col" class="px-4 py-3 font-medium">Название</th>
                    <th scope="col" class="px-4 py-3 font-medium">Типы</th>
                    <th scope="col" class="px-4 py-3 font-medium text-right">Конструкций</th>
                    <th scope="col" class="px-4 py-3 font-medium">Обновлено</th>
                    <th scope="col" class="px-4 py-3 font-medium"><span class="sr-only">Действия</span></th>
                </tr>
            </thead>
            <tbody>
                {% for category in categories %}
                    {% set used = productCounts[category.id] ?? 0 %}
                    <tr>
                        <td class="px-4 py-3">
                            {% if category.imagePath %}
                                <img src="{{ asset(category.imagePath) }}" alt="" class="w-20 h-14 object-cover rounded-base border border-default">
                            {% else %}
                                <div class="w-20 h-14 rounded-base bg-neutral-tertiary-medium flex items-center justify-center text-xs text-body">нет фото</div>
                            {% endif %}
                        </td>
                        <th scope="row" class="px-4 py-3 font-medium text-heading">
                            <a href="{{ path('admin_category_edit', {id: category.id}) }}" class="hover:underline">{{ category.name }}</a>
                            {% if category.shortDescription %}
                                <div class="text-xs font-normal text-body mt-1">{{ category.shortDescription }}</div>
                            {% endif %}
                        </th>
                        <td class="px-4 py-3">
                            <div class="flex flex-wrap gap-1">
                                {% for type in category.productTypes %}
                                    <span class="bg-brand-softer border border-brand-subtle text-fg-brand-strong text-xs font-medium px-1.5 py-0.5 rounded-sm">{{ type.name }}</span>
                                {% else %}
                                    —
                                {% endfor %}
                            </div>
                        </td>
                        <td class="px-4 py-3 text-right">
                            {% if used %}
                                <a href="{{ path('admin_product_index', {category: category.id}) }}" class="font-medium text-fg-brand hover:underline">{{ used }}</a>
                            {% else %}0{% endif %}
                        </td>
                        <td class="px-4 py-3 whitespace-nowrap">{{ category.updatedAt|date('d.m.Y H:i') }}</td>
                        <td class="px-4 py-3">
                            <div class="flex justify-end gap-2">
                                <a href="{{ path('admin_category_edit', {id: category.id}) }}" class="btn btn-secondary btn-sm">Изменить</a>
                                {{ include('admin/_delete_form.html.twig', {
                                    action: path('admin_category_delete', {id: category.id}),
                                    token_id: 'delete-category-' ~ category.id,
                                    confirm: 'Удалить категорию «' ~ category.name ~ '»?',
                                }) }}
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6" class="px-4 py-10 text-center">
                            Категорий пока нет. <a href="{{ path('admin_category_new') }}" class="font-medium text-fg-brand hover:underline">Добавить первую</a>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
