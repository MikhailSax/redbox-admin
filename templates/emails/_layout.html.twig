{#
    Frame of the website's e-mails: red REDBOX header, one call to action, contacts.
    Blocks: title, kicker, body; vars: url + button for the call to action.
#}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}{% endblock %} — REDBOX</title>
</head>
<body style="margin:0;padding:0;background:#f3f2f2;font-family:Arial,Helvetica,sans-serif;color:#201e1d">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f3f2f2">
    <tr>
        <td align="center" style="padding:32px 16px">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:560px;background:#ffffff;border:2px solid #d8d6d5">
                <tr>
                    <td style="background:#e30613;padding:20px 28px;color:#f3f2f2;font-weight:bold;font-size:20px;letter-spacing:-0.01em">REDBOX</td>
                </tr>
                <tr>
                    <td style="padding:32px 28px 8px">
                        <div style="font-size:12px;letter-spacing:0.14em;text-transform:uppercase;color:#e30613;margin-bottom:12px">{% block kicker %}Личный кабинет{% endblock %}</div>
                        <h1 style="margin:0 0 18px;font-size:26px;line-height:1.1;text-transform:uppercase">{{ block('title') }}</h1>
                        <p style="margin:0 0 14px;font-size:15px;line-height:1.55">Здравствуйте{{ name ? ', ' ~ name : '' }}!</p>
                        {% block body %}{% endblock %}
                        <a href="{{ url }}" style="display:inline-block;margin-top:10px;background:#e30613;color:#f3f2f2;text-decoration:none;font-weight:bold;font-size:14px;letter-spacing:0.06em;text-transform:uppercase;padding:15px 22px">{{ button }}</a>
                        {% block note %}{% endblock %}
                        <p style="margin:16px 0 0;font-size:12px;line-height:1.5;color:#8a8785;word-break:break-all">Если кнопка не открывается, скопируйте ссылку в браузер:<br>{{ url }}</p>
                    </td>
                </tr>
                <tr>
                    <td style="padding:24px 28px;border-top:2px solid #eeeceb;font-size:12px;line-height:1.6;color:#8a8785">
                        Отдел размещения REDBOX · 8 (983) 436-67-77 · sales@redbox03.ru
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>
</body>
</html>
