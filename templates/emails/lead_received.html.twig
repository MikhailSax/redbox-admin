{% extends 'emails/_layout.html.twig' %}

{% block kicker %}Заявка на размещение{% endblock %}

{% block title %}Заявка №{{ lead.id }} принята{% endblock %}

{% block body %}
    <p style="margin:0 0 14px;font-size:15px;line-height:1.55">Спасибо! Мы получили заявку. Менеджер проверит, свободны ли конструкции в эти даты, и свяжется с вами.</p>
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:0 0 14px;border-collapse:collapse;font-size:13px;line-height:1.45">
        {% for item in lead.items %}
            <tr>
                <td style="padding:8px 0;border-top:1px solid #eeeceb">{{ item.productTitle }}{% if item.sideName %}<span style="color:#8a8785"> · {{ item.sideName }}</span>{% endif %}</td>
                <td style="padding:8px 0 8px 12px;border-top:1px solid #eeeceb;white-space:nowrap;text-align:right;color:#6b6866">{{ item.startDate|date('d.m.Y') }} — {{ item.endDate|date('d.m.Y') }}</td>
            </tr>
        {% endfor %}
        <tr>
            <td style="padding:10px 0;border-top:2px solid #d8d6d5;font-weight:bold">По прайсу</td>
            <td style="padding:10px 0 10px 12px;border-top:2px solid #d8d6d5;font-weight:bold;white-space:nowrap;text-align:right">{{ lead.estimate|money }}</td>
        </tr>
    </table>
    <p style="margin:0 0 14px;font-size:13px;line-height:1.55;color:#6b6866">Итоговую цену менеджер пришлёт в медиаплане: в ней будут скидки и услуги.</p>
{% endblock %}
